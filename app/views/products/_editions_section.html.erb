<section class="mt-8">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-base font-semibold"><%= t("products.editions.title") %></h2>
    <%= link_to new_product_edition_path(product), class: "btn-secondary" do %>
      <%= icon :plus, classes: "size-3.5" %> <%= t("products.editions.new") %>
    <% end %>
  </div>

  <% if editions.any? %>
    <div class="card overflow-hidden">
      <table class="table-base">
        <thead>
          <tr>
            <th><%= t("products.editions.columns.name") %></th>
            <th><%= t("products.editions.columns.dates") %></th>
            <th><%= t("products.editions.columns.lines_in_use") %></th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          <% editions.each do |edition| %>
            <tr class="cursor-pointer" onclick="Turbo.visit('<%= edit_product_edition_path(product, edition) %>')">
              <td class="font-medium"><%= edition.name %></td>
              <td class="text-ink-soft">
                <% if edition.date_range_label.present? %>
                  <%= edition.date_range_label %>
                <% else %>
                  <span class="text-ink-faint">—</span>
                <% end %>
              </td>
              <td class="text-ink-soft tabular-nums"><%= edition.deal_products.size %></td>
              <td onclick="event.stopPropagation()">
                <%= button_to product_edition_path(product, edition), method: :delete, class: "text-ink-faint hover:text-danger p-1",
                      form: { data: { turbo_confirm: t("products.editions.delete_confirm", name: edition.name) } } do %>
                  <%= icon :trash, classes: "size-3.5" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-base text-ink-faint"><%= t("products.editions.empty") %></p>
  <% end %>
</section>
