<% page_title "Products" %>
<% actions = capture do %>
  <%= link_to new_product_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> New product
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Products", icon_name: :briefcase, count: @products.size, actions: actions %>
<%= render "tabs", active: "products" %>

<div class="flex flex-wrap items-center gap-2 border-b border-line px-5 py-2 shrink-0">
  <%= form_with url: products_path, method: :get, class: "flex flex-wrap items-center gap-2 flex-1" do %>
    <div class="relative max-w-xs min-w-40 flex-1">
      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-ink-faint"><%= icon :search, classes: "size-3.5" %></span>
      <%= text_field_tag :q, params[:q], placeholder: "Search products...", class: "input pl-8" %>
    </div>
    <%= select_tag :segment,
          options_for_select([["All segments", ""]] + Product::SEGMENTS.map { |s| [Product::SEGMENT_LABELS[s], s] }, params[:segment]),
          class: "input w-auto" %>
    <% if params[:q].present? || params[:segment].present? %>
      <%= link_to "Clear", products_path(clear_filters: 1), class: "btn-ghost" %>
    <% end %>
  <% end %>
</div>

<div class="flex-1 overflow-auto scrollbar-subtle">
  <% if @products.any? %>
    <table class="table-base">
      <thead>
        <tr>
          <th><%= sort_link "Name", :name %></th>
          <th>Description</th>
          <th><%= sort_link "Segment", :segment %></th>
          <th><%= sort_link "Price", :price %></th>
          <th class="w-10"></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr class="cursor-pointer" onclick="Turbo.visit('<%= edit_product_path(product) %>')">
            <td class="font-medium"><%= product.name %></td>
            <td class="text-ink-soft truncate max-w-md"><%= product.description %></td>
            <td>
              <% if product.segment_label.present? %>
                <%= badge product.segment_label %>
              <% else %>
                <span class="text-ink-faint">—</span>
              <% end %>
            </td>
            <td class="text-ink-soft tabular-nums"><%= money(product.price) %></td>
            <td onclick="event.stopPropagation()">
              <%= button_to product_path(product), method: :delete, class: "text-ink-faint hover:text-danger p-1",
                    form: { data: { turbo_confirm: "Delete #{product.name}?" } } do %>
                <%= icon :trash, classes: "size-3.5" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <% action = capture do %>
      <%= link_to new_product_path, class: "btn-primary" do %>
        <%= icon :plus, classes: "size-3.5" %> New product
      <% end %>
    <% end %>
    <%= render "shared/empty_state", icon_name: :briefcase, title: "No products yet",
          subtitle: "Build a catalogue to add as line items on your deals.", action: action %>
  <% end %>
</div>
