<%= form_with model: stage_trigger,
      url: stage_trigger.persisted? ? stage_trigger_path(stage_trigger) : pipeline_stage_stage_triggers_path(stage),
      html: { data: { controller: "stage-trigger-form" } }, class: "card p-4 space-y-4" do |f| %>
  <% if stage_trigger.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= stage_trigger.errors.full_messages.join(". ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nombre", class: "label" %>
    <%= f.text_field :name, class: "input w-full", placeholder: "Avisar al comercial" %>
  </div>

  <div>
    <%= f.label :execution_mode, "Modo de ejecución", class: "label" %>
    <%= f.select :execution_mode,
          [ [ "Agente IA (instrucción en lenguaje natural)", "llm" ], [ "Función nativa (Ruby)", "native" ] ], {},
          class: "input w-full",
          data: { "stage-trigger-form-target" => "mode", action: "stage-trigger-form#refresh" } %>
  </div>

  <div data-stage-trigger-form-target="llmFields">
    <%= f.label :instructions, "Instrucción", class: "label" %>
    <%= f.text_area :instructions, rows: 4, class: "input w-full resize-y",
          placeholder: "Ej.: Resume el estado del deal y muéstralo en el panel. Si el valor supera 10.000 €, avisa con un toast." %>
    <p class="text-sm text-ink-faint mt-1">
      La IA puede consultar el deal, su empresa y contactos (solo lectura) y mostrar toasts, alertas,
      confirmaciones o un panel dentro del deal.
    </p>
  </div>

  <div data-stage-trigger-form-target="nativeFields" hidden>
    <%= f.label :native_function, "Función", class: "label" %>
    <%= f.select :native_function,
          StageTriggers::NativeRegistry.entries.map { |e| [ e.label, e.key ] },
          { include_blank: "— Elegir función —" },
          class: "input w-full",
          data: { "stage-trigger-form-target" => "nativeFunction", action: "stage-trigger-form#refresh" } %>
    <% StageTriggers::NativeRegistry.entries.each do |entry| %>
      <p class="text-sm text-ink-faint mt-1" data-stage-trigger-form-target="hint" data-function="<%= entry.key %>" hidden>
        <%= entry.description %>
      </p>
    <% end %>

    <% StageTriggers::NativeRegistry.entries.select { |e| e.params.any? }.each do |entry| %>
      <fieldset class="mt-3 space-y-3" data-stage-trigger-form-target="paramFields" data-function="<%= entry.key %>" hidden>
        <% entry.params.each do |param| %>
          <% field_name = "stage_trigger[native_params][#{param.key}]" %>
          <% value = stage_trigger.native_params[param.key] %>
          <div>
            <label class="label"><%= param.label %><%= " *" if param.required %></label>
            <% case param.type %>
            <% when "text" %>
              <%= text_area_tag field_name, value, rows: 3, class: "input w-full resize-y",
                    placeholder: param.placeholder, id: nil %>
            <% when "select" %>
              <%= select_tag field_name, options_for_select(param.options || [], value),
                    class: "input w-full", id: nil %>
            <% else %>
              <%= text_field_tag field_name, value, class: "input w-full",
                    placeholder: param.placeholder, id: nil %>
            <% end %>
          </div>
        <% end %>
      </fieldset>
    <% end %>
  </div>

  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> Activo</label>
  <%= f.submit stage_trigger.persisted? ? "Guardar" : "Crear disparador", class: "btn-primary" %>
<% end %>
