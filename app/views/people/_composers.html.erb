<% composers = [["note", "Add note"], ["task", "Create task"]] %>
<% composers << ["email", "Send email"] if feature_enabled?(:record_email) %>
<% composers << ["comment", "Add comment"] if feature_enabled?(:comments) %>
<% composers.each do |key, title| %>
  <dialog class="record-composer" data-record-workspace-target="composer" data-composer="<%= key %>" aria-labelledby="record-compose-<%= key %>" data-action="close->record-workspace#composerClosed">
    <div class="record-composer-header">
      <div><h2 id="record-compose-<%= key %>" class="text-lg font-semibold"><%= title %></h2><p class="text-sm text-ink-soft mt-1"><%= @person.display_name %></p></div>
      <button type="button" class="btn-ghost" data-action="record-workspace#closeComposer" aria-label="Close editor"><%= icon :x, classes: "size-5" %></button>
    </div>
    <div class="p-5 sm:p-6">
      <% case key %>
      <% when "note" %>
        <%= form_with model: @note, url: notes_path, class: "space-y-4" do |f| %>
          <%= hidden_field_tag :notable_type, "Person" %><%= hidden_field_tag :notable_id, @person.id %>
          <div><%= f.label :title, "Title (optional)", class: "label" %><%= f.text_field :title, class: "input", placeholder: "What is this note about?" %></div>
          <div><%= f.label :body, "Note", class: "label" %><%= f.text_area :body, rows: 6, class: "input", required: true, placeholder: "Write a note…" %></div>
          <div class="record-composer-footer"><button type="button" class="btn-secondary" data-action="record-workspace#closeComposer">Close</button><%= f.submit "Add note", class: "btn-primary" %></div>
        <% end %>
      <% when "task" %>
        <%= form_with model: @task, url: tasks_path, class: "space-y-4" do |f| %>
          <%= hidden_field_tag :taskable_type, "Person" %><%= hidden_field_tag :taskable_id, @person.id %>
          <div><%= f.label :title, "Task", class: "label" %><%= mention_text_field f, :title, placeholder: "What needs to happen next?", class: "input w-full", wrapper_class: "w-full", required: true %></div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div><%= f.label :due_on, "Due date", class: "label" %><%= f.date_field :due_on, class: "input" %></div>
            <div><%= f.label :assignee_id, "Assignee", class: "label" %><%= f.collection_select :assignee_id, current_workspace.users.order(:name), :id, :name, { selected: current_user.id }, class: "input" %></div>
          </div>
          <div class="record-composer-footer"><button type="button" class="btn-secondary" data-action="record-workspace#closeComposer">Close</button><%= f.submit "Create task", class: "btn-primary" %></div>
        <% end %>
      <% when "email" %>
        <%= render "shared/email_section", record: @person, email_message: @email_message, show_history: false %>
      <% when "comment" %>
        <%= form_with model: @comment, url: comments_path, class: "space-y-4" do |f| %>
          <%= hidden_field_tag :commentable_type, "Person" %><%= hidden_field_tag :commentable_id, @person.id %>
          <div><%= f.label :body, "Comment", class: "label" %><%= f.text_area :body, rows: 5, class: "input", required: true, placeholder: "Mention a teammate with @name…" %></div>
          <div class="record-composer-footer"><button type="button" class="btn-secondary" data-action="record-workspace#closeComposer">Close</button><%= f.submit "Add comment", class: "btn-primary" %></div>
        <% end %>
      <% end %>
      <p class="text-xs text-ink-soft mt-4">You can close this editor and switch sections. Your draft stays here until you leave the page.</p>
    </div>
  </dialog>
<% end %>
