<% page_title "Envío de formulario" %>
<%= render "shared/page_header",
      title: @submission.lead_form.name,
      icon_name: :globe,
      actions: capture { link_to "Volver a persona", @person, class: "btn-secondary" } %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
<div class="card p-6 max-w-2xl space-y-4">
  <div class="grid grid-cols-2 gap-3 text-sm">
    <div><span class="text-ink-faint">Persona</span><br><%= link_to @person.display_name, @person, class: "text-accent hover:underline" %></div>
    <div><span class="text-ink-faint">Destino captura</span><br><%= @submission.capture_destination.upcase %></div>
    <div><span class="text-ink-faint">Fecha</span><br><%= l(@submission.created_at, format: :long) %></div>
    <% if @submission.deal %>
      <div class="col-span-2"><span class="text-ink-faint">Deal</span><br><%= link_to @submission.deal.name, @submission.deal, class: "text-accent hover:underline" %></div>
    <% end %>
  </div>

  <%= render "lead_submissions/consent_accepted", submission: @submission %>

  <div>
    <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">Respuestas</h3>
    <dl class="divide-y divide-line text-sm">
      <% @submission.data.each do |key, value| %>
        <div class="py-2 grid grid-cols-3 gap-2">
          <dt class="text-ink-faint"><%= key.humanize %></dt>
          <dd class="col-span-2"><%= value.is_a?(TrueClass) || value.is_a?(FalseClass) ? (value ? "Sí" : "No") : value %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
</div>
