<div class="record-information-grid">
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">Contact details</h2><%= link_to "Edit", edit_person_path(@person, section: "contact"), class: "btn-ghost", aria: { label: "Edit contact details" } %></div>
    <div class="divide-y divide-line/60">
      <%= render "emails_section", person: @person %>
      <%= render "shared/attribute", label: "Phone", icon_name: :phone, value: @person.phone %>
      <%= render "shared/attribute", label: "Location", icon_name: :map_pin, value: @person.location %>
    </div>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">Professional profile</h2><%= link_to "Edit", edit_person_path(@person, section: "profile"), class: "btn-ghost", aria: { label: "Edit professional profile" } %></div>
    <div class="divide-y divide-line/60">
      <%= render "shared/attribute", label: "Job title", icon_name: :users, value: @person.job_title %>
      <%= render "shared/attribute", label: "Company", icon_name: :building, value: @person.company ? link_to(@person.company.name, company_path(@person.company), class: "text-accent hover:underline") : nil %>
      <%= render "shared/attribute", label: "LinkedIn", icon_name: :external, value: @person.linkedin_url.present? ? link_to("Profile", @person.linkedin_url, target: "_blank", rel: "noopener", class: "text-accent hover:underline") : nil %>
      <%= render "shared/attribute", label: "X / Twitter", icon_name: :external, value: @person.twitter_url.present? ? link_to("Profile", @person.twitter_url, target: "_blank", rel: "noopener", class: "text-accent hover:underline") : nil %>
    </div>
    <% if @person.description.present? %><p class="mt-4 text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @person.description %></p><% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">Contact management</h2><%= link_to "Edit", edit_person_path(@person, section: "management"), class: "btn-ghost", aria: { label: "Edit contact management" } %></div>
    <%= render "shared/attribute", label: "Owner", icon_name: :users, value: @person.owner&.name %>
    <%= render "shared/attribute", label: "Created", icon_name: :clock, value: l(@person.created_at, format: :short) %>
    <% if @person.lists.any? %>
      <h3 class="text-sm font-medium mt-4 mb-2">Lists</h3>
      <div class="flex flex-wrap gap-2"><% @person.lists.each do |list| %><%= link_to list.name, list_path(list), class: "record-count hover:text-accent" %><% end %></div>
    <% end %>
  </section>
  <section class="record-card"><%= render "relationships_section", person: @person %></section>
  <% if @person.custom_field_definitions.any? %>
    <section class="record-card">
      <div class="record-card-heading"><h2 class="record-section-title">Custom fields</h2><%= link_to "Edit", edit_person_path(@person, section: "custom"), class: "btn-ghost", aria: { label: "Edit custom fields" } %></div>
      <%= render "shared/custom_attributes", record: @person %>
    </section>
  <% end %>
  <% if feature_enabled?(:marketing_consent) %><section class="record-card"><h2 class="record-section-title mb-4">Email preferences</h2><%= render "subscriptions_section", person: @person %></section><% end %>
</div>
