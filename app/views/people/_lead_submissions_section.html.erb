<%# locals: (person:) %>
<div class="mt-4">
  <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-1.5">Formularios enviados</h3>
  <% grouped = person.lead_submissions.includes(:lead_form).order(created_at: :desc).group_by(&:lead_form_id) %>
  <% if grouped.any? %>
    <ul class="space-y-2">
      <% grouped.each_value do |submissions| %>
        <% form = submissions.first.lead_form %>
        <li class="rounded-md border border-line px-3 py-2 text-sm">
          <p class="font-medium"><%= form.name %></p>
          <p class="text-xs text-ink-faint"><%= submissions.size %> envío(s) · <%= l(submissions.map(&:created_at).min, format: :short) %> — <%= l(submissions.map(&:created_at).max, format: :short) %></p>
          <ul class="mt-2 space-y-1">
            <% submissions.first(3).each do |submission| %>
              <li>
                <%= link_to person_lead_submission_path(person, submission), class: "text-accent hover:underline" do %>
                  <%= l(submission.created_at, format: :short) %> · Ver consentimiento
                <% end %>
                · <%= submission.capture_destination.upcase %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-ink-faint px-2">Sin envíos de formularios.</p>
  <% end %>
</div>
