<% page_title @person.display_name %>
<div class="record-workspace" data-controller="record-workspace"
     data-action="turbo:before-visit@document->record-workspace#beforeVisit beforeunload@window->record-workspace#beforeUnload input->record-workspace#markDirty change->record-workspace#markDirty submit->record-workspace#submit turbo:submit-end->record-workspace#submitted">
  <header class="record-header">
    <div class="flex items-center gap-2 text-sm text-ink-soft mb-5">
      <button type="button" class="btn-ghost md:hidden" aria-label="Open menu" data-action="mobile-nav#open"><%= icon :menu, classes: "size-4" %></button>
      <%= link_to "People", people_path, class: "hover:text-accent hover:underline" %>
      <span aria-hidden="true">/</span><span>Contact overview</span>
    </div>
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <%= avatar @person, size: "size-14", text: "text-lg" %>
        <div class="min-w-0">
          <h1 class="text-2xl font-semibold tracking-tight break-words"><%= @person.display_name %></h1>
          <p class="text-base text-ink-soft mt-1">
            <%= @person.job_title %>
            <% if @person.job_title.present? && @person.company %><span aria-hidden="true"> · </span><% end %>
            <% if @person.company %><%= link_to @person.company.name, company_path(@person.company), class: "hover:text-accent hover:underline" %><% end %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <%= link_to edit_person_path(@person), class: "btn-secondary" do %><%= icon :pencil, classes: "size-3.5" %><span>Edit</span><% end %>
        <details class="record-menu">
          <summary class="btn-ghost" aria-label="More contact actions">•••</summary>
          <div class="record-menu-items">
            <%= link_to merge_person_path(@person), class: "btn-ghost justify-start" do %><%= icon :users, classes: "size-4" %> Merge duplicates<% end %>
            <%= button_to person_path(@person), method: :delete, form: { data: { turbo_confirm: "Delete #{@person.display_name}? This cannot be undone." } }, class: "btn-ghost text-danger w-full justify-start" do %><%= icon :trash, classes: "size-4" %> Delete contact<% end %>
          </div>
        </details>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm mt-4 text-ink-soft">
      <% if @person.email.present? %><%= mail_to @person.email, class: "inline-flex items-center gap-2 break-all hover:text-accent" do %><%= icon :mail, classes: "size-4 shrink-0" %><%= @person.email %><% end %><% end %>
      <% if @person.phone.present? %><%= link_to "tel:#{@person.phone}", class: "inline-flex items-center gap-2 hover:text-accent" do %><%= icon :phone, classes: "size-4" %><%= @person.phone %><% end %><% end %>
      <% if @person.location.present? %><span class="inline-flex items-center gap-2"><%= icon :map_pin, classes: "size-4" %><%= @person.location %></span><% end %>
    </div>
    <div class="record-actions">
      <% if feature_enabled?(:record_email) %>
        <button type="button" class="btn-primary" data-action="record-workspace#openComposer" data-composer="email"><%= icon :mail, classes: "size-4" %> Send email</button>
      <% end %>
      <button type="button" class="btn-secondary" data-action="record-workspace#openComposer" data-composer="note"><%= icon :note, classes: "size-4" %> Add note</button>
      <button type="button" class="btn-secondary" data-action="record-workspace#openComposer" data-composer="task"><%= icon :check_circle, classes: "size-4" %> Create task</button>
      <%= render "quick_deal_dialog", person: @person %>
    </div>
  </header>

  <nav class="record-tabs" aria-label="Contact sections" role="tablist">
    <% tabs = [["activity", "Activity", nil], ["deals", "Deals", @deals.size], ["information", "Information", nil]] %>
    <% tabs << ["files", "Files", @person.record_attachments.count] if feature_enabled?(:attachments) %>
    <% tabs.each do |key, label, count| %>
      <%= link_to person_path(@person, tab: key, product_id: @deal_product_id), id: "record-tab-#{key}", role: "tab", class: "record-tab", tabindex: @person_tab == key ? 0 : -1,
            aria: { selected: @person_tab == key, controls: "record-panel-#{key}" },
            data: { record_workspace_target: "tab", tab: key, action: "click->record-workspace#selectTab keydown->record-workspace#navigateTabs" } do %>
        <%= label %><% unless count.nil? %><span class="record-count"><%= count %></span><% end %>
      <% end %>
    <% end %>
  </nav>

  <div class="record-content">
    <section id="record-panel-activity" role="tabpanel" aria-labelledby="record-tab-activity" tabindex="0" data-record-workspace-target="panel" <%= "hidden" unless @person_tab == "activity" %>>
      <div class="record-overview-grid">
        <div class="min-w-0 space-y-6">
          <section class="record-card" aria-labelledby="record-next-tasks">
            <div class="flex items-center justify-between gap-3 mb-4">
              <h2 id="record-next-tasks" class="record-section-title">Next tasks <span class="record-count"><%= @pending_tasks.size %></span></h2>
              <button type="button" class="btn-ghost" data-action="record-workspace#openComposer" data-composer="task"><%= icon :plus, classes: "size-4" %> Add</button>
            </div>
            <% if @pending_tasks.any? %>
              <ul class="space-y-2"><%= render partial: "shared/task_row", collection: @pending_tasks.first(3), as: :task %></ul>
              <% if @pending_tasks.size > 3 %>
                <details class="record-disclosure mt-3"><summary>Show <%= @pending_tasks.size - 3 %> more pending tasks</summary><ul class="space-y-2 mt-3"><%= render partial: "shared/task_row", collection: @pending_tasks.drop(3), as: :task %></ul></details>
              <% end %>
            <% else %>
              <p class="text-sm text-ink-soft">No pending tasks. Create a task to plan your next follow-up.</p>
            <% end %>
            <% if @completed_tasks.any? %>
              <details class="record-disclosure mt-4"><summary>Completed tasks (<%= @completed_tasks.size %>)</summary><ul class="space-y-2 mt-3"><%= render partial: "shared/task_row", collection: @completed_tasks, as: :task %></ul></details>
            <% end %>
          </section>
          <%= render "activity_feed" %>
        </div>
        <aside class="space-y-5 min-w-0" aria-label="Contact context">
          <section class="record-card">
            <h2 class="record-section-title mb-4">At a glance</h2>
            <dl class="record-context-list">
              <div><dt>Owner</dt><dd><%= @person.owner&.name || "Unassigned" %></dd></div>
              <div><dt>Company</dt><dd><%= @person.company&.name || "—" %></dd></div>
              <% if feature_enabled?(:lead_scoring) %>
                <div><dt>Lifecycle</dt><dd><%= @person.lifecycle_stage&.humanize %></dd></div>
                <div><dt>Lead score</dt><dd><%= @person.lead_score %></dd></div>
              <% end %>
            </dl>
            <button type="button" class="btn-ghost mt-4 -ml-2" data-action="record-workspace#selectTab" data-tab="information">View all information <%= icon :chevron_right, classes: "size-3.5" %></button>
          </section>
          <section class="record-card">
            <h2 class="record-section-title mb-4">Open deals</h2>
            <% open_deals = @deals.select(&:open) %>
            <% if open_deals.any? %>
              <ul class="space-y-4">
                <% open_deals.first(3).each do |deal| %>
                  <li><%= link_to deal.name, deal_path(deal), class: "block font-medium hover:text-accent break-words" %><div class="mt-2"><%= stage_badge deal %></div></li>
                <% end %>
              </ul>
              <button type="button" class="btn-ghost mt-4 -ml-2" data-action="record-workspace#selectTab" data-tab="deals">View deals (<%= @deals.size %>) <%= icon :chevron_right, classes: "size-3.5" %></button>
            <% else %><p class="text-sm text-ink-soft">No open deals.</p><% end %>
          </section>
          <% if feature_enabled?(:marketing_campaigns) %>
            <%= render "campaigns_section", messages: @person_campaign_messages || [] %>
          <% end %>
          <% if feature_enabled?(:ai_assistant) %>
            <details class="record-disclosure record-card"><summary>AI Assistant</summary><div class="mt-4"><%= render "shared/ai_assistant_section", record: @person %></div></details>
          <% end %>
        </aside>
      </div>
    </section>

    <section id="record-panel-deals" role="tabpanel" aria-labelledby="record-tab-deals" tabindex="0" data-record-workspace-target="panel" <%= "hidden" unless @person_tab == "deals" %>>
      <div class="space-y-6">
        <%= render "deals_panel" %>
        <% if feature_enabled?(:mql_pool) %>
          <div class="record-information-grid">
            <section class="record-card"><%= render "product_interests_section", person: @person %></section>
            <section class="record-card"><%= render "lead_submissions_section", person: @person %></section>
          </div>
        <% end %>
      </div>
    </section>
    <section id="record-panel-information" role="tabpanel" aria-labelledby="record-tab-information" tabindex="0" data-record-workspace-target="panel" <%= "hidden" unless @person_tab == "information" %>>
      <%= render "information_panel" %>
    </section>
    <% if feature_enabled?(:attachments) %>
      <section id="record-panel-files" role="tabpanel" aria-labelledby="record-tab-files" tabindex="0" data-record-workspace-target="panel" <%= "hidden" unless @person_tab == "files" %>>
        <div class="record-card"><%= render "shared/attachments_section", record: @person %></div>
      </section>
    <% end %>
  </div>
  <%= render "composers" %>
</div>
