<% page_title "Convertir a SQL" %>
<%= render "shared/page_header", title: "Convertir a SQL", subtitle: @person.display_name, icon_name: :zap %>

<div class="card p-6 max-w-xl space-y-4">
  <div class="rounded-lg border border-line bg-canvas-sunken/40 p-3 text-sm">
    <p><strong>Producto:</strong> <%= @interest.product.name %></p>
    <p><strong>Señal:</strong> <%= @interest.description %></p>
    <p><strong>Fecha:</strong> <%= l(@interest.occurred_at, format: :short) %></p>
  </div>

  <%= form_with url: person_product_interest_conversion_path(@person, @interest), class: "space-y-4" do |f| %>
    <div>
      <%= label_tag "conversion[pipeline_id]", "Pipeline", class: "label" %>
      <%= select_tag "conversion[pipeline_id]",
            options_from_collection_for_select(@pipelines, :id, :name, @default_pipeline&.id),
            required: true, class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "conversion[name]", "Nombre del deal", class: "label" %>
      <%= text_field_tag "conversion[name]", "#{@person.company.name} — #{@interest.product.name}", class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "conversion[task_title]", "Próxima acción", class: "label" %>
      <%= text_field_tag "conversion[task_title]", "Contactar tras interés en #{@interest.product.name}", required: true, class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "conversion[task_due_on]", "Fecha de la tarea", class: "label" %>
      <%= date_field_tag "conversion[task_due_on]", Date.current + 3.days, min: Date.current, required: true, class: "input w-full" %>
    </div>
    <div class="flex gap-2 justify-end">
      <%= link_to "Cancelar", @person, class: "btn-secondary" %>
      <%= submit_tag "Crear oportunidad", class: "btn-primary" %>
    </div>
  <% end %>
</div>
