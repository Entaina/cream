<% page_title "Atribución" %>
<% totals = @rows.each_with_object({ visits: 0, leads: 0, mqls: 0, deals: 0, revenue: 0.0 }) do |row, sum|
  sum[:visits] += row.visits
  sum[:leads] += row.leads
  sum[:mqls] += row.mqls
  sum[:deals] += row.deals
  sum[:revenue] += row.revenue
end %>
<%= render "shared/page_header", title: "Atribución de marketing", icon_name: :bar_chart %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-4">
  <%= form_with url: marketing_attribution_path, method: :get, class: "card p-4 flex flex-wrap gap-3 items-end" do %>
    <div>
      <label class="label">UTM source</label>
      <%= text_field_tag :utm_source, params[:utm_source], class: "input", placeholder: "newsletter" %>
    </div>
    <div>
      <label class="label">UTM medium</label>
      <%= text_field_tag :utm_medium, params[:utm_medium], class: "input", placeholder: "email" %>
    </div>
    <div>
      <label class="label">UTM campaign</label>
      <%= text_field_tag :utm_campaign, params[:utm_campaign], class: "input", placeholder: "marzo-2026" %>
    </div>
    <div>
      <label class="label">Periodo</label>
      <%= select_tag :date_range,
            options_for_select([ [ "Mes actual", "month" ], [ "Trimestre", "quarter" ], [ "Año", "year" ] ], params[:date_range] || "month"),
            class: "input" %>
    </div>
    <%= submit_tag "Filtrar", class: "btn-secondary" %>
  <% end %>

  <% if @rows.empty? %>
    <%= render "shared/empty_state", icon_name: :bar_chart, title: "Sin datos de atribución",
          subtitle: "Cuando haya visitas, leads o deals con parámetros UTM, aparecerán aquí agrupados por canal." %>
  <% else %>
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr>
            <th>Canal (source)</th>
            <th>Visitas</th>
            <th>Leads</th>
            <th>MQL</th>
            <th>Deals</th>
            <th>Ingresos</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td class="font-medium"><%= row.label %></td>
              <td class="tabular-nums"><%= row.visits %></td>
              <td class="tabular-nums">
                <%= link_to row.leads, people_path(utm_source: row.key), class: "text-accent hover:underline" %>
              </td>
              <td class="tabular-nums">
                <%= link_to row.mqls, people_path(utm_source: row.key, lifecycle_stage_in: Marketing::ScoringEngine::MQL_STAGES), class: "text-accent hover:underline" %>
              </td>
              <td class="tabular-nums">
                <%= link_to row.deals, deals_path(utm_source: row.key), class: "text-accent hover:underline" %>
              </td>
              <td class="tabular-nums"><%= number_to_currency(row.revenue) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="font-semibold bg-canvas-sunken/50">
            <td>Total</td>
            <td class="tabular-nums"><%= totals[:visits] %></td>
            <td class="tabular-nums"><%= totals[:leads] %></td>
            <td class="tabular-nums"><%= totals[:mqls] %></td>
            <td class="tabular-nums"><%= totals[:deals] %></td>
            <td class="tabular-nums"><%= number_to_currency(totals[:revenue]) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
