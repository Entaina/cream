<div class="space-y-6">
  <section class="record-card">
    <% pipelines = current_workspace.pipelines.ordered %>
    <% if pipelines.size > 1 %>
      <div class="mb-6">
        <h2 class="record-section-title mb-3">Pipeline</h2>
        <%= form_with url: move_pipeline_deal_path(@deal), method: :patch,
              data: { turbo_confirm: "Move this deal to the selected pipeline? It will start at that pipeline's first stage." } do %>
          <%= select_tag :pipeline_id, options_for_select(pipelines.map { |p| [p.name, p.id] }, @deal.pipeline_id),
                class: "input", onchange: "this.form.requestSubmit()" %>
        <% end %>
      </div>
    <% end %>

    <%= render "stage_stepper", deal: @deal %>
  </section>

  <% if feature_enabled?(:stage_triggers) %>
    <%= render "trigger_panel", deal: @deal, run: StageTriggerRun.latest_panel_for(@deal) %>
  <% end %>
</div>
