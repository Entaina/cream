<div data-controller="deal-contacts" data-deal-contacts-people-url-value="<%= people_path %>" class="space-y-4">
  <%= render "shared/company_select", form: f,
        select_data: {"deal-contacts-target": "companySelect", action: "change->deal-contacts#companyChanged"} %>

  <%= render RecordPickerComponent.new(
        form: f,
        attribute: :partner_id,
        label: "Partner",
        scope: current_workspace.companies.order(:name),
        search_url: picker_companies_path(format: :json),
        create_url: companies_path(format: :json),
        create_param: "company",
        selected_name: f.object.partner&.name,
        required: false,
        hidden_data: {"deal-contacts-target": "partnerSelect", action: "change->deal-contacts#companyChanged"},
        hint_method: :domain
      ) %>

  <div>
    <%= f.label :contact_ids, "Contacts", class: "label" %>
    <div class="flex items-start gap-2">
      <% deal_contacts = []
         deal_contacts += f.object.company.people.order(:first_name, :last_name) if f.object.company
         deal_contacts += f.object.partner.people.order(:first_name, :last_name) if f.object.partner
         deal_contacts.uniq! %>
      <%= f.select :contact_ids,
            options_from_collection_for_select(deal_contacts, :id, :display_name, f.object.contact_ids),
            {}, multiple: true, size: 5, class: "input", data: {"deal-contacts-target": "select"} %>
      <button type="button" class="btn-secondary shrink-0 whitespace-nowrap" data-action="deal-contacts#open">
        <%= icon :plus, classes: "size-3.5" %> New
      </button>
    </div>
    <p class="mt-1 text-xs text-ink-faint">Optional. Contacts of the client company or partner. Hold ⌘/Ctrl to pick several.</p>
    <p data-deal-contacts-target="notice" class="hidden mt-1 text-xs text-danger"></p>
  </div>

  <dialog data-deal-contacts-target="dialog" class="modal-dialog max-w-md rounded-xl border border-line shadow-lg backdrop:bg-chicago-950/40">
    <div class="p-4 space-y-3">
      <h3 class="text-base font-semibold">New contact</h3>
      <p data-deal-contacts-target="error" class="hidden text-sm text-danger"></p>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <div>
          <label class="label">First name</label>
          <input type="text" data-deal-contacts-target="firstName" class="input" data-action="keydown.enter->deal-contacts#create" />
        </div>
        <div>
          <label class="label">Last name</label>
          <input type="text" data-deal-contacts-target="lastName" class="input" data-action="keydown.enter->deal-contacts#create" />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <div>
          <label class="label">Email</label>
          <input type="email" data-deal-contacts-target="email" class="input" />
        </div>
        <div>
          <label class="label">Phone</label>
          <input type="tel" data-deal-contacts-target="phone" class="input" />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <div>
          <label class="label">Contact source</label>
          <select data-deal-contacts-target="source" class="input" data-action="change->deal-contacts#sourceChanged">
            <option value="">Select source</option>
            <% Person::SOURCES.each do |value, label| %>
              <option value="<%= value %>"><%= label %></option>
            <% end %>
          </select>
          <div data-deal-contacts-target="broughtByRow" class="hidden mt-3">
            <label class="label">Team member</label>
            <select data-deal-contacts-target="broughtBy" class="input">
              <option value="">Select team member</option>
              <% current_workspace.users.order(:name).each do |user| %>
                <option value="<%= user.id %>"><%= user.name %></option>
              <% end %>
            </select>
          </div>
        </div>
        <div>
          <label class="label">First contact date</label>
          <input type="date" data-deal-contacts-target="firstContactOn" class="input" />
        </div>
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" class="btn-secondary" data-action="deal-contacts#close">Cancel</button>
        <button type="button" class="btn-primary" data-deal-contacts-target="submit" data-action="deal-contacts#create">Create contact</button>
      </div>
    </div>
  </dialog>
</div>
