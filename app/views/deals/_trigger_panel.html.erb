<%# locals: deal:, run: (StageTriggerRun with panel content, or nil) %>
<div id="deal_trigger_panel_<%= deal.id %>">
  <% if run&.panel_markdown.present? %>
    <div class="card p-4 space-y-2">
      <div class="flex items-start justify-between gap-2">
        <h3 class="text-base font-semibold text-ink flex items-center gap-1.5">
          <%= icon :zap, classes: "size-4 text-accent" %>
          <%= run.panel_title.presence || "Disparador de etapa" %>
        </h3>
        <button type="button" class="text-ink-faint hover:text-ink" title="Ocultar"
                onclick="this.closest('[id^=deal_trigger_panel_]').replaceChildren()">
          <%= icon :x, classes: "size-4" %>
        </button>
      </div>
      <div class="text-base text-ink-soft space-y-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_a]:text-accent [&_a]:underline [&_h1]:font-semibold [&_h2]:font-semibold [&_h3]:font-semibold">
        <%= StageTriggers::MarkdownRenderer.render(run.panel_markdown) %>
      </div>
      <p class="text-xs text-ink-faint"><%= run.stage_trigger.name %> · <%= run.created_at.strftime("%d/%m/%Y %H:%M") %></p>
    </div>
  <% end %>
</div>
