<div class="mt-4 card p-4">
  <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-3">Origen de la reserva</h3>
  <% booking = deal.booking %>
  <p class="text-sm text-ink-faint mb-3">
    Reservado el <%= l(booking.created_at, format: :short) %> en
    <strong><%= booking.booking_page.name %></strong>
  </p>
  <div class="divide-y divide-line/60">
    <% %w[booking_page_name booking_page_slug source_page referrer utm_source utm_medium utm_campaign utm_term utm_content ip user_agent].each do |key| %>
      <% value = booking.metadata[key] %>
      <% next if value.blank? %>
      <%= render "shared/attribute", label: key.humanize, icon_name: :globe, value: value %>
    <% end %>
  </div>
</div>
