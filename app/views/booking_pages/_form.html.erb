<%= form_with model: booking_page,
      class: "space-y-6",
      data: {
        controller: "booking-page-form",
        booking_page_form_calendars_url_value: calendars_booking_pages_path,
        booking_page_form_selected_ids_value: booking_page.calendar_ids.to_json,
        booking_page_form_calendars_value: @available_calendars.to_json,
        booking_page_form_calendars_error_value: @calendars_load_error.to_s,
        booking_page_form_host_connected_value: @host_calendar_connection&.connected? == true
      } do |f| %>
  <% if booking_page.errors.any? %>
    <div class="card p-4 border-red-200 bg-red-50 text-red-800 text-sm">
      <%= booking_page.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
    <div class="card p-6 space-y-4 lg:sticky lg:top-0 lg:self-start min-w-0">
      <h2 class="font-display text-lg font-semibold">Página pública</h2>
      <div>
        <%= f.label :name, "Nombre", class: "label" %>
        <%= f.text_field :name, class: "input mt-1 w-full" %>
      </div>
      <div>
        <%= f.label :slug, "Slug (URL)", class: "label" %>
        <%= f.text_field :slug, class: "input mt-1 w-full", placeholder: "alex" %>
        <% if booking_page.persisted? %>
          <p class="text-xs text-ink-faint mt-1">URL: <%= public_booking_page_url(booking_page.slug) %></p>
        <% end %>
      </div>
      <div>
        <%= f.label :host_id, "Anfitrión (calendario)", class: "label" %>
        <%= f.collection_select :host_id, @hosts, :id, :name, {},
              class: "input mt-1 w-full",
              data: {
                booking_page_form_target: "hostSelect",
                action: "change->booking-page-form#hostChanged"
              } %>
        <p class="text-xs text-ink-faint mt-1">Debe tener Google Calendar conectado para consultar disponibilidad y crear citas.</p>
      </div>
      <div>
        <%= f.label :pipeline_id, "Pipeline CRM", class: "label" %>
        <%= f.collection_select :pipeline_id, @pipelines, :id, :name, {}, class: "input mt-1 w-full" %>
      </div>
      <div>
        <%= f.label :welcome_message, "Mensaje de bienvenida", class: "label" %>
        <%= f.text_area :welcome_message, rows: 2, class: "input mt-1 w-full" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :avatar_url, "Avatar URL", class: "label" %>
          <%= f.url_field :avatar_url, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= f.label :logo_url, "Logo URL", class: "label" %>
          <%= f.url_field :logo_url, class: "input mt-1 w-full" %>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :timezone, "Zona horaria", class: "label" %>
          <%= f.select :timezone, booking_timezone_options(booking_page.timezone), {}, class: "input mt-1 w-full" %>
        </div>
        <div>
          <%= f.label :booking_window_days, "Ventana de reserva (días)", class: "label" %>
          <%= f.number_field :booking_window_days, min: 1, class: "input mt-1 w-full" %>
        </div>
      </div>
      <div>
        <p class="label">Calendarios</p>
        <p class="text-xs text-ink-faint mb-2">Marca los calendarios donde comprobar disponibilidad y arrastra para ordenarlos. Las nuevas citas se crean en el primero marcado con permiso de escritura.</p>
        <div data-booking-page-form-target="calendarError"
             class="hidden text-sm text-red-600 mb-2"></div>
        <% if @calendars_load_error.present? %>
          <p class="text-sm text-red-600 mb-2">
            <%= @calendars_load_error %>
            <% if @calendars_load_error_code == :api_disabled && @calendars_load_help_url.present? %>
              <%= link_to "Activar Google Calendar API", @calendars_load_help_url, class: "text-accent hover:underline ml-1", target: "_blank", rel: "noopener" %>
            <% elsif @host_calendar_connection&.user_id == current_user.id && @calendars_load_error_code != :api_disabled %>
              <%= link_to "Reconectar Google Calendar", calendar_connection_path, class: "text-accent hover:underline ml-1" %>
            <% end %>
          </p>
        <% elsif @host_calendar_connection&.connected? && @host_calendar_connection.missing_scopes_message %>
          <p class="text-sm text-golden-800 bg-golden-100 rounded-md px-3 py-2 mb-2">
            <%= @host_calendar_connection.missing_scopes_message %>
            <% if @host_calendar_connection.user_id == current_user.id %>
              <%= link_to "Reconectar Google Calendar", calendar_connection_path, class: "text-accent hover:underline ml-1" %>
            <% end %>
          </p>
        <% elsif @host_calendar_connection.blank? || !@host_calendar_connection.connected? %>
          <p class="text-sm text-ink-soft mb-2">
            El anfitrión no tiene Google Calendar conectado.
            <%= link_to "Conectar ahora", calendar_connection_path, class: "text-accent hover:underline" %>
          </p>
        <% end %>
        <div data-booking-page-form-target="calendarList"></div>
        <div data-booking-page-form-target="calendarIdsInputs"></div>
        <p data-booking-page-form-target="calendarHint"
           class="text-xs text-ink-faint mt-2 <%= "hidden" if @available_calendars.blank? %>">
          Arrastra el asa para cambiar el orden. El badge «Recibe nuevas citas» indica dónde se crearán los eventos.
        </p>
      </div>
      <div>
        <%= f.label :active, class: "inline-flex items-center gap-2" do %>
          <%= f.check_box :active %>
          <span>Página activa</span>
        <% end %>
      </div>
    </div>

    <div class="card p-6 space-y-4 min-w-0" data-controller="nested-form sortable-list" data-action="nested-form:changed->sortable-list#refresh">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h2 class="font-display text-lg font-semibold">Tipos de evento</h2>
          <p class="text-xs text-ink-faint mt-1">Arrastra para cambiar el orden. Pulsa una tarjeta para editarla.</p>
        </div>
        <button type="button" data-action="nested-form#add" class="btn-secondary shrink-0">
          <%= icon :plus, classes: "size-3.5" %> Añadir tipo
        </button>
      </div>
      <div data-nested-form-target="list" data-sortable-list-target="list" class="space-y-2">
        <%= f.fields_for :event_types do |event_form| %>
          <%= render "event_type_fields", form: event_form %>
        <% end %>
      </div>
      <template data-nested-form-target="template">
        <%= f.fields_for :event_types,
              BookingEventType.new(BookingEventType.blank_attributes),
              child_index: "NEW_RECORD" do |event_form| %>
          <%= render "event_type_fields", form: event_form %>
        <% end %>
      </template>
    </div>
  </div>

  <div class="sticky bottom-0 z-10 -mx-5 px-5 py-3 bg-canvas/95 backdrop-blur-sm border-t border-line flex gap-2">
    <%= f.submit booking_page.persisted? ? "Guardar" : "Crear", class: "btn-primary" %>
    <%= link_to "Cancelar", booking_pages_path, class: "btn-secondary" %>
  </div>
<% end %>
