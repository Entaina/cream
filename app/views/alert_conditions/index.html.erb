<% page_title "Condiciones — #{@alert_rule.name}" %>
<% actions = capture do %>
  <%= link_to edit_alert_rule_path(@alert_rule), class: "btn-secondary" do %>
    <%= icon :arrow_left, classes: "size-3.5" %> Alerta
  <% end %>
  <%= link_to new_alert_rule_alert_condition_path(@alert_rule), class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nueva condición
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Condiciones adicionales — #{@alert_rule.name}",
      icon_name: :bell, count: @alert_conditions.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <p class="text-sm text-ink-faint">
    Para que un deal dispare la alerta <strong><%= @alert_rule.name %></strong> deben cumplirse
    <strong>todas</strong> las condiciones activas además del disparador de fecha.
    Los campos de contacto se evalúan sobre <strong>cualquiera</strong> de los contactos del deal.
  </p>
  <% if @alert_conditions.empty? %>
    <p class="text-base text-ink-soft">No hay condiciones adicionales para esta alerta todavía.</p>
  <% end %>
  <% @alert_conditions.each do |condition| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base"><%= condition.field_label %></h2>
        <%= badge condition.active? ? "Activa" : "Inactiva", color: condition.active? ? "green" : "chicago" %>
        <div class="ml-auto flex gap-2">
          <%= link_to "Editar", edit_alert_condition_path(condition), class: "btn-secondary" %>
          <%= button_to "Eliminar", alert_condition_path(condition), method: :delete, class: "btn-danger",
                data: { turbo_confirm: "¿Eliminar esta condición?" } %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1"><%= condition.describe %></p>
    </article>
  <% end %>
</div>
