<% content_for :title, "Vista previa: #{@template.display_name}" %>

<div class="mx-auto max-w-xl space-y-4">
  <div class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-100 space-y-3">
    <div>
      <p class="font-medium">Vista previa de plantilla</p>
      <p class="mt-1">
        Estás viendo <strong class="font-mono"><%= @template.display_name %></strong>.
        <% if @preview_draft %>
          Incluye cambios sin guardar del editor.
        <% end %>
        El formulario no enviará datos reales.
      </p>
      <%= link_to "Volver al editor", edit_lead_form_template_path(@template), class: "mt-2 inline-block text-accent hover:underline" %>
    </div>

    <% if @preview_draft %>
      <% if @preview_product %>
        <p class="text-xs">Producto: <strong><%= @preview_product.name %></strong></p>
      <% end %>
    <% elsif @preview_products.any? %>
      <%= render "preview_product_field",
            products: @preview_products,
            selected_id: @preview_product&.id,
            auto_submit: true,
            form_url: preview_lead_form_template_path(@template),
            form_method: :get %>
    <% end %>
  </div>

  <%= @lead_form_page_html.html_safe %>
</div>
