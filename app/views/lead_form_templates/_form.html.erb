<%= form_with model: template, class: "card p-4 space-y-4 max-w-5xl" do |f| %>
  <% if template.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
      <%= template.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :slug, "Nombre", class: "label" %>
    <%= f.text_field :slug, class: "input w-full font-mono", placeholder: "contacto", required: true %>
    <p class="mt-1 text-xs text-ink-faint">Identificador de la plantilla (p. ej. <code class="font-mono">contacto</code>, <code class="font-mono">contact_fields</code>). Se usa en el selector de formularios y en <code class="font-mono">{% partial 'nombre' %}</code>.</p>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :partial %> Es un parcial (partial)
  </label>

  <div>
    <%= f.label :body, "Contenido Liquid", class: "label" %>
    <%= render "shared/liquid_editor", form: f, field: :body, rows: 24, required: true %>
    <p class="mt-1 text-xs text-ink-faint">Usa etiquetas como {% field %}, {% partial 'nombre' %}, {% form_open %} y variables {{ lead_form.name }}.</p>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to "Cancelar", lead_form_templates_path, class: "btn-secondary" %>
  </div>
<% end %>
