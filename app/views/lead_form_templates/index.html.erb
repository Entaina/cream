<% page_title "Plantillas de formularios públicos" %>
<% actions = capture do %>
  <%= link_to lead_forms_path, class: "btn-secondary" do %>
    Volver a formularios
  <% end %>
  <%= link_to new_lead_form_template_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nueva plantilla
  <% end %>
<% end %>

<div class="flex flex-col flex-1 min-h-0 overflow-hidden">
  <%= render "shared/page_header", title: "Plantillas de formularios públicos", icon_name: :globe, count: @templates.size, actions: actions %>

  <div class="flex items-center gap-1 border-b border-line px-5 py-2 shrink-0">
    <% { "all" => "Todas", "view" => "Páginas", "partial" => "Parciales" }.each do |key, label| %>
      <%= link_to label, lead_form_templates_path(kind: key == "all" ? nil : key),
            class: [ "rounded-md px-2.5 py-1 text-sm font-medium",
                     @kind == key ? "bg-canvas-sunken text-ink" : "text-ink-faint hover:text-ink" ] %>
    <% end %>
  </div>

  <div class="flex-1 min-h-0 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @templates.empty? %>
    <% if @kind == "all" %>
      <p class="text-ink-faint">Todavía no hay plantillas en este workspace.</p>
    <% else %>
      <p class="text-ink-faint">No hay plantillas de este tipo.</p>
    <% end %>
  <% end %>

  <% @templates.each do |template| %>
    <article class="card p-4">
      <div class="flex items-center gap-2 mb-2">
        <h2 class="font-semibold text-base font-mono"><%= template.display_name %></h2>
        <%= badge template.partial? ? "Parcial" : "Página", color: template.partial? ? "hoki" : "green" %>
        <div class="ml-auto flex gap-2">
          <%= link_to "Editar", edit_lead_form_template_path(template), class: "btn-secondary" %>
          <%= button_to "Eliminar", lead_form_template_path(template), method: :delete, class: "btn-danger" %>
        </div>
      </div>
      <div class="mt-2">
        <%= render "shared/liquid_preview", body: template.body %>
      </div>
    </article>
  <% end %>
  </div>
</div>
