<% page_title alert_rule.persisted? ? "Editar alerta" : "Nueva alerta" %>
<%= render "shared/page_header", title: alert_rule.persisted? ? "Editar alerta" : "Nueva alerta", icon_name: :bell, actions: nil %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-2xl">
    <%= form_with model: alert_rule, class: "card p-4 space-y-4" do |f| %>
      <% if alert_rule.errors.any? %>
        <div class="text-sm text-red-600">
          <%= alert_rule.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Nombre", class: "label" %>
        <%= f.text_field :name, class: "input w-full", placeholder: "Edición finalizada sin datos fiscales" %>
      </div>

      <div>
        <%= f.label :trigger_field, "Campo de fecha", class: "label" %>
        <%= f.select :trigger_field,
              AlertRule::TRIGGER_FIELDS.map { |key| [ AlertRule::TRIGGER_FIELD_LABELS.fetch(key), key ] },
              {}, class: "input w-full" %>
        <p class="text-sm text-ink-faint mt-1">
          La alerta se evalúa cuando la fecha cumplida más el desfase es hoy o anterior.
        </p>
      </div>

      <div>
        <%= f.label :offset_days, "Desfase (días)", class: "label" %>
        <%= f.number_field :offset_days, class: "input w-full" %>
        <p class="text-sm text-ink-faint mt-1">
          0 = el mismo día. Valores negativos avisan con antelación (p. ej. -7 = una semana antes).
        </p>
      </div>

      <div data-controller="nested-form">
        <div class="flex items-center justify-between gap-2 mb-2">
          <div>
            <p class="label">Condiciones adicionales</p>
            <p class="text-sm text-ink-faint">
              Todas las condiciones activas deben cumplirse además del disparador de fecha.
              Los campos de contacto se evalúan sobre cualquiera de los contactos del deal.
            </p>
          </div>
          <button type="button" data-action="nested-form#add" class="btn-secondary shrink-0">
            <%= icon :plus, classes: "size-3.5" %> Añadir condición
          </button>
        </div>

        <div data-nested-form-target="list" class="space-y-3">
          <%= f.fields_for :alert_conditions do |cf| %>
            <%= render "condition_fields", f: cf %>
          <% end %>
        </div>

        <template data-nested-form-target="template">
          <%= f.fields_for :alert_conditions, AlertCondition.new(active: true, operator: "eq"),
                child_index: "NEW_RECORD" do |cf| %>
            <%= render "condition_fields", f: cf %>
          <% end %>
        </template>
      </div>

      <div>
        <%= f.label :recipient, "Destinatario", class: "label" %>
        <%= f.select :recipient,
              AlertRule::RECIPIENTS.map { |key| [ AlertRule::RECIPIENT_LABELS.fetch(key), key ] },
              {}, class: "input w-full" %>
      </div>

      <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> Activa</label>
      <%= f.submit alert_rule.persisted? ? "Guardar" : "Crear alerta", class: "btn-primary" %>
      <%= link_to "Cancelar", alert_rules_path, class: "btn-secondary ml-2" %>
    <% end %>
  </div>
</div>
