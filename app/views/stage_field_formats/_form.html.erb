<%= form_with model: stage_field_format,
      url: stage_field_format.persisted? ? stage_field_format_path(stage_field_format) : pipeline_stage_stage_field_formats_path(stage),
      html: { data: { controller: "stage-field-format-form" } }, class: "card p-4 space-y-4" do |f| %>
  <% if stage_field_format.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= stage_field_format.errors.full_messages.join(". ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :field, "Campo", class: "label" %>
    <%= f.select :field, StageFieldFormat::FIELDS.map { |key, label| [ label, key ] }, {}, class: "input w-full" %>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
    <div>
      <%= f.label :operator, "Condición", class: "label" %>
      <%= f.select :operator, StageFieldFormat::OPERATORS.map { |key, label| [ label, key ] }, {},
            class: "input w-full",
            data: { "stage-field-format-form-target" => "operator", action: "stage-field-format-form#refresh" } %>
    </div>
    <div data-stage-field-format-form-target="compareValue">
      <%= f.label :compare_value, "Valor", class: "label" %>
      <%= f.text_field :compare_value, class: "input w-full", placeholder: "Ej.: 0" %>
    </div>
  </div>

  <div>
    <%= f.label :display_text, "Mostrar", class: "label" %>
    <%= f.text_field :display_text, class: "input w-full", placeholder: "Ej.: guest" %>
    <p class="text-sm text-ink-faint mt-1">Texto que sustituye al valor del campo cuando se cumple la condición.</p>
  </div>

  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> Activo</label>
  <%= f.submit stage_field_format.persisted? ? "Guardar" : "Crear formato", class: "btn-primary" %>
<% end %>
