<% page_title "Edit #{@company.name}" %>
<%= render "shared/page_header", title: "Edit #{@company.name}", icon_name: :building, count: nil, actions: nil %>
<div class="flex-1 overflow-y-auto bg-canvas-soft/50 p-4 sm:p-6">
  <div class="max-w-2xl mx-auto">
    <%= link_to "← Back to company", company_path(@company, tab: "information"), class: "inline-block text-sm text-ink-soft hover:text-accent mb-5" %>
    <%= render "form", company: @company %>
  </div>
</div>
