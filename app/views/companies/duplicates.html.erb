<% page_title "Possible duplicates" %>
<% actions = capture do %>
  <%= link_to companies_path, class: "btn-secondary" do %>
    <%= icon :building, classes: "size-3.5" %> All companies
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Possible duplicates", icon_name: :building, count: @groups.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <% if @groups.any? %>
    <div class="space-y-4 max-w-4xl">
      <% @groups.each do |group| %>
        <% primary = group.companies.first %>
        <section class="card p-4">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
            <div>
              <h2 class="text-base font-semibold"><%= primary.name %></h2>
              <p class="text-sm text-ink-faint"><%= group.reason %></p>
            </div>
            <%= link_to merge_company_path(primary, secondary_ids: group.companies.drop(1).map(&:id)),
                  class: "btn-primary" do %>
              <%= icon :building, classes: "size-3.5" %> Review merge
            <% end %>
          </div>

          <ul class="divide-y divide-line/60">
            <% group.companies.each do |company| %>
              <li class="flex items-center justify-between gap-3 py-2.5">
                <div class="flex items-center gap-3 min-w-0">
                  <%= avatar company %>
                  <div class="min-w-0">
                    <p class="font-medium truncate">
                      <%= link_to company.name, company_path(company), class: "hover:text-accent" %>
                    </p>
                    <p class="text-sm text-ink-faint truncate">
                      <%= [ company.domain, company.industry ].compact_blank.join(" · ") %>
                    </p>
                  </div>
                </div>
                <div class="text-sm text-ink-faint shrink-0 text-right">
                  <% if company == primary %>
                    <span class="badge">Keep by default</span>
                  <% end %>
                  <p><%= pluralize(company.people.size, "person") %> · <%= pluralize(company.deals.size, "deal") %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", icon_name: :building, title: "No duplicate companies found",
          subtitle: "Cream looks for companies with similar names or the same domain." %>
  <% end %>
</div>
