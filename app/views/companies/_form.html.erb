<%= form_with model: company, class: "space-y-4",
      data: { controller: "linkedin-suggest", linkedin_suggest_entity_value: "company" } do |f| %>
  <% if company.errors.any? %>
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <ul class="list-disc list-inside">
        <% company.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, class: "input", autofocus: true %>
    </div>
    <div>
      <%= f.label :domain, class: "label" %>
      <%= f.text_field :domain, class: "input", placeholder: "acme.com" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :industry, class: "label" %>
      <%= f.text_field :industry, class: "input", placeholder: "SaaS, Fintech..." %>
    </div>
    <div>
      <%= f.label :employee_range, "Employees", class: "label" %>
      <%= f.select :employee_range, Company::EMPLOYEE_RANGES, { include_blank: "Unknown" }, class: "input" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :location, class: "label" %>
      <%= f.text_field :location, class: "input", placeholder: "City, Country" %>
    </div>
    <div>
      <%= f.label :annual_revenue, "Annual revenue (€)", class: "label" %>
      <%= f.number_field :annual_revenue, class: "input", min: 0, step: 1000 %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <div class="flex items-center justify-between gap-2">
        <%= f.label :linkedin_url, "LinkedIn URL", class: "label mb-0" %>
        <button type="button" class="btn-ghost shrink-0 text-sm py-1 px-2"
                data-action="linkedin-suggest#search"
                title="Abre la búsqueda de LinkedIn con el nombre de la empresa">
          <%= icon :search, classes: "size-3.5" %> Buscar en LinkedIn
        </button>
      </div>
      <%= f.url_field :linkedin_url, class: "input" %>
    </div>
    <div>
      <%= f.label :owner_id, "Owner", class: "label" %>
      <%= f.collection_select :owner_id, current_workspace.users, :id, :name, { include_blank: "Unassigned" }, class: "input" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description, rows: 3, class: "input" %>
  </div>

  <div>
    <%= f.label :fiscal_information, "Fiscal information", class: "label" %>
    <%= f.text_area :fiscal_information, rows: 4, class: "input",
          placeholder: "Razón social, CIF/NIF, dirección fiscal, IBAN..." %>
  </div>

  <%= render "shared/custom_fields_form", form: f, record: company %>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit company.persisted? ? "Save changes" : "Create company", class: "btn-primary" %>
    <%= link_to "Cancel", company.persisted? ? company_path(company) : companies_path, class: "btn-secondary" %>
  </div>
<% end %>
