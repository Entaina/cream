<div class="record-information-grid">
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">Company details</h2><%= link_to "Edit", edit_company_path(@company, section: "profile"), class: "btn-ghost", aria: { label: "Edit company details" } %></div>
    <div class="divide-y divide-line/60">
      <%= render "shared/attribute", label: "Domain", icon_name: :external, value: @company.domain.present? ? link_to(@company.domain, "https://#{@company.domain}", target: "_blank", rel: "noopener", class: "text-accent hover:underline") : nil %>
      <%= render "shared/attribute", label: "Industry", icon_name: :briefcase, value: @company.industry %>
      <%= render "shared/attribute", label: "Employees", icon_name: :users, value: @company.employee_range %>
      <%= render "shared/attribute", label: "Location", icon_name: :map_pin, value: @company.location %>
      <%= render "shared/attribute", label: "Revenue", icon_name: :banknote, value: @company.annual_revenue.present? ? money(@company.annual_revenue) : nil %>
      <%= render "shared/attribute", label: "LinkedIn", icon_name: :external, value: @company.linkedin_url.present? ? link_to("Profile", @company.linkedin_url, target: "_blank", rel: "noopener", class: "text-accent hover:underline") : nil %>
      <%= render "shared/attribute", label: "X / Twitter", icon_name: :external, value: @company.twitter_url.present? ? link_to("Profile", @company.twitter_url, target: "_blank", rel: "noopener", class: "text-accent hover:underline") : nil %>
    </div>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">About</h2><%= link_to "Edit", edit_company_path(@company, section: "about"), class: "btn-ghost", aria: { label: "Edit about section" } %></div>
    <% if @company.description.present? %>
      <p class="text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @company.description %></p>
    <% else %>
      <p class="text-sm text-ink-soft">No description yet.</p>
    <% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">Fiscal information</h2><%= link_to "Edit", edit_company_path(@company, section: "fiscal"), class: "btn-ghost", aria: { label: "Edit fiscal information" } %></div>
    <% if @company.fiscal_information.present? %>
      <p class="text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @company.fiscal_information %></p>
    <% else %>
      <p class="text-sm text-ink-soft">No fiscal information yet.</p>
    <% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title">Management</h2><%= link_to "Edit", edit_company_path(@company, section: "management"), class: "btn-ghost", aria: { label: "Edit management" } %></div>
    <%= render "shared/attribute", label: "Owner", icon_name: :users, value: @company.owner&.name %>
    <%= render "shared/attribute", label: "Created", icon_name: :clock, value: l(@company.created_at, format: :short) %>
    <% if @company.lists.any? %>
      <h3 class="text-sm font-medium mt-4 mb-2">Lists</h3>
      <div class="flex flex-wrap gap-2"><% @company.lists.each do |list| %><%= link_to list.name, list_path(list), class: "record-count hover:text-accent" %><% end %></div>
    <% end %>
  </section>
  <% if @company.custom_field_definitions.any? %>
    <section class="record-card">
      <div class="record-card-heading"><h2 class="record-section-title">Custom fields</h2><%= link_to "Edit", edit_company_path(@company, section: "custom"), class: "btn-ghost", aria: { label: "Edit custom fields" } %></div>
      <%= render "shared/custom_attributes", record: @company %>
    </section>
  <% end %>
</div>
