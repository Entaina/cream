<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div><%= f.label :name, class: "label" %><%= f.text_field :name, class: "input", autofocus: true %></div>
  <div><%= f.label :domain, class: "label" %><%= f.text_field :domain, class: "input", placeholder: "acme.com" %></div>
</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div><%= f.label :industry, class: "label" %><%= f.text_field :industry, class: "input", placeholder: "SaaS, Fintech..." %></div>
  <div><%= f.label :employee_range, "Employees", class: "label" %><%= f.select :employee_range, Company::EMPLOYEE_RANGES, { include_blank: "Unknown" }, class: "input" %></div>
</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div><%= f.label :location, class: "label" %><%= f.text_field :location, class: "input", placeholder: "City, Country" %></div>
  <div><%= f.label :annual_revenue, "Annual revenue (€)", class: "label" %><%= f.number_field :annual_revenue, class: "input", min: 0, step: 1000 %></div>
</div>
<div>
  <div class="flex items-center justify-between gap-2 mb-1">
    <%= f.label :linkedin_url, "LinkedIn URL", class: "label mb-0" %>
    <button type="button" class="btn-ghost text-sm" data-action="linkedin-suggest#search">Search LinkedIn</button>
  </div>
  <%= f.url_field :linkedin_url, class: "input", placeholder: "https://linkedin.com/company/…" %>
</div>
<div><%= f.label :twitter_url, "X / Twitter URL", class: "label" %><%= f.url_field :twitter_url, class: "input" %></div>
