<% page_title "Condiciones — #{@stage.name}" %>
<% actions = capture do %>
  <%= link_to edit_pipeline_path(@stage.pipeline), class: "btn-secondary" do %>
    <%= icon :arrow_left, classes: "size-3.5" %> Pipeline
  <% end %>
  <%= link_to new_pipeline_stage_stage_condition_path(@stage), class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nueva condición
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Condiciones de entrada — #{@stage.name} (#{@stage.pipeline.name})",
      icon_name: :lock, count: @stage_conditions.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <p class="text-sm text-ink-faint">
    Para pasar un deal a la etapa <strong><%= @stage.name %></strong> deben cumplirse
    <strong>todas</strong> las condiciones activas. Los campos de contacto se evalúan sobre
    <strong>cualquiera</strong> de los contactos del deal.
  </p>
  <% if @stage_conditions.empty? %>
    <p class="text-base text-ink-soft">No hay condiciones para esta etapa todavía.</p>
  <% end %>
  <% @stage_conditions.each do |condition| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base"><%= condition.field_label %></h2>
        <%= badge condition.active? ? "Activa" : "Inactiva", color: condition.active? ? "green" : "chicago" %>
        <div class="ml-auto flex gap-2">
          <%= link_to "Editar", edit_stage_condition_path(condition), class: "btn-secondary" %>
          <%= button_to "Eliminar", stage_condition_path(condition), method: :delete, class: "btn-danger",
                data: { turbo_confirm: "¿Eliminar esta condición?" } %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1">
        <strong><%= condition.field_label %></strong>
        <%= StageCondition::OPERATORS[condition.operator] %><%= " #{condition.compare_value}" unless condition.blank_or_present_operator? %>
      </p>
    </article>
  <% end %>
</div>
