<% page_title "Plantillas de email" %>
<% actions = capture do %>
  <%= link_to new_email_layout_path, class: "btn-secondary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nuevo layout
  <% end %>
  <%= link_to new_email_template_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nueva plantilla
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Plantillas de email", icon_name: :mail, count: @templates.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-6">
  <section class="space-y-3">
    <div class="flex items-center gap-2">
      <h2 class="font-semibold text-base">Layouts</h2>
      <span class="text-sm text-ink-faint"><%= @layouts.size %></span>
    </div>
    <% if @layouts.empty? %>
      <p class="text-sm text-ink-faint">Los layouts envuelven el cuerpo de las plantillas con cabecera, pie y estilos comunes. Usa <code class="font-mono">{{ content }}</code> en el HTML.</p>
    <% else %>
      <% @layouts.each do |layout| %>
        <article class="card p-4">
          <div class="flex items-center gap-2 mb-2">
            <h3 class="font-semibold text-base"><%= layout.name %></h3>
            <span class="text-xs text-ink-faint"><%= pluralize(layout.email_templates.count, "plantilla", "plantillas") %></span>
            <div class="ml-auto flex gap-2">
              <%= link_to "Editar", edit_email_layout_path(layout), class: "btn-secondary" %>
              <%= button_to "Eliminar", email_layout_path(layout), method: :delete, class: "btn-danger",
                    form: { data: { turbo_confirm: "¿Eliminar el layout «#{layout.name}»? Las plantillas quedarán sin layout." } } %>
            </div>
          </div>
          <p class="text-base text-ink-soft mt-1"><%= email_body_preview(layout.body, length: 200) %></p>
        </article>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-3">
    <div class="flex items-center gap-2">
      <h2 class="font-semibold text-base">Plantillas</h2>
      <span class="text-sm text-ink-faint"><%= @templates.size %></span>
    </div>
    <% @templates.each do |template| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 mb-2">
          <h3 class="font-semibold text-base"><%= template.name %></h3>
          <%= badge "Compartida", color: "hoki" if template.shared %>
          <%= badge template.body_editor == "html" ? "HTML" : "Enriquecido", color: "chicago" %>
          <% if template.email_layout %>
            <%= badge template.email_layout.name, color: "hoki" %>
          <% end %>
          <div class="ml-auto flex gap-2">
            <%= link_to "Editar", edit_email_template_path(template), class: "btn-secondary" %>
            <%= button_to "Eliminar", email_template_path(template), method: :delete, class: "btn-danger" %>
          </div>
        </div>
        <p class="text-sm text-ink-faint"><%= template.subject %></p>
        <p class="text-base text-ink-soft mt-1"><%= email_body_preview(template.body, length: 200) %></p>
        <% if template.attachments.attached? %>
          <ul class="mt-2 space-y-1">
            <% template.attachments.each do |file| %>
              <li class="flex items-center gap-2 text-sm text-ink-faint">
                <%= icon :paperclip, classes: "size-3.5" %>
                <span><%= file.filename %></span>
                <span class="text-xs"><%= number_to_human_size(file.byte_size) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </article>
    <% end %>
  </section>
</div>
