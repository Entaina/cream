<%= form_with model: template, class: "card p-4 space-y-3", multipart: true do |f| %>
  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :subject, class: "label" %>
    <%= f.text_field :subject, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :body, class: "label" %>
    <%= render "shared/rich_text_editor", form: f, field: :body, placeholder: "Hi {first_name}, ..." %>
  </div>
  <% if template.attachments.attached? %>
    <div>
      <p class="label">Adjuntos actuales</p>
      <ul class="space-y-1">
        <% template.attachments.each do |file| %>
          <li class="flex items-center gap-2 text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= check_box_tag "purge_attachment_ids[]", file.id, false, class: "rounded border-line" %>
              <%= icon :paperclip, classes: "size-3.5 text-ink-faint" %>
              <span class="text-ink-soft"><%= file.filename %></span>
              <span class="text-xs text-ink-faint"><%= number_to_human_size(file.byte_size) %></span>
            </label>
          </li>
        <% end %>
      </ul>
      <p class="text-xs text-ink-faint mt-1">Marca los que quieras eliminar al guardar.</p>
    </div>
  <% end %>
  <div>
    <%= f.label :attachments, "Añadir adjuntos", class: "label" %>
    <%= f.file_field :attachments, multiple: true, class: "file-input" %>
  </div>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :shared %> Compartir con el workspace
  </label>
  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to "Cancel", email_templates_path, class: "btn-secondary" %>
  </div>
<% end %>
