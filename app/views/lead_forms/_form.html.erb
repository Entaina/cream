<%= form_with model: lead_form, class: "card p-4 space-y-3" do |f| %>
  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input w-full", required: true %>
  </div>
  <div>
    <%= f.label :slug, "Slug (URL pública)", class: "label" %>
    <%= f.text_field :slug, class: "input w-full", placeholder: "contacto-curso-ia" %>
    <p class="text-xs text-ink-faint mt-1">Se usará en /f/slug. Solo letras minúsculas, números y guiones.</p>
  </div>
  <div>
    <%= f.label :template_key, "Plantilla del formulario", class: "label" %>
    <%= f.select :template_key, options_for_select(@template_keys, lead_form.template_key), {}, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :pipeline_id, "Pipeline por defecto", class: "label" %>
    <%= f.collection_select :pipeline_id, @pipelines, :id, :name, {}, class: "input w-full" %>
    <% if lead_form.contacto_template? %>
      <p class="text-xs text-ink-faint mt-1">Se usa cuando no hay ruta específica o el lead elige «Otro».</p>
    <% end %>
  </div>
  <% if lead_form.contacto_template? %>
    <div class="space-y-3">
      <p class="label">Pipeline según «¿En qué te ayudamos?»</p>
      <% LeadForm::CONTACTO_HELP_OPTIONS.each do |label, key| %>
        <div>
          <%= label_tag "lead_form_pipeline_routes_#{key}", label, class: "label" %>
          <%= select_tag "lead_form[pipeline_routes][#{key}]",
                options_from_collection_for_select(@pipelines, :id, :name, lead_form.pipeline_routes[key]),
                include_blank: "Usar pipeline por defecto",
                class: "input w-full",
                id: "lead_form_pipeline_routes_#{key}" %>
        </div>
      <% end %>
    </div>
  <% end %>
  <div>
    <%= f.label :responsible_id, "Responsable", class: "label" %>
    <%= f.collection_select :responsible_id, @responsibles, :id, :name, {}, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :email_template_id, "Plantilla de email al lead", class: "label" %>
    <%= f.collection_select :email_template_id, @email_templates, :id, :name, {}, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :success_redirect_url, "URL de redirección tras envío", class: "label" %>
    <%= f.url_field :success_redirect_url, class: "input w-full", placeholder: "https://entaina.com/gracias" %>
    <p class="text-xs text-ink-faint mt-1">Opcional. Si se deja vacío, se muestra la página de gracias de Cream (/f/slug/success).</p>
  </div>
  <div>
    <%= f.label :hidden_field_keys_text, "Campos ocultos adicionales", class: "label" %>
    <%= f.text_area :hidden_field_keys_text, class: "input w-full font-mono text-sm", rows: 4, placeholder: "producto\nlanding" %>
    <p class="text-xs text-ink-faint mt-1">Uno por línea. Se leen de la URL pública, p. ej. /f/slug?producto=curso-ia</p>
  </div>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :collects_company %> Recoger datos de empresa (nombre y CIF)
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :active %> Activo
  </label>
  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to "Cancelar", lead_forms_path, class: "btn-secondary" %>
  </div>
<% end %>
