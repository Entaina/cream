<%= form_with model: lead_form, class: "mx-auto max-w-5xl space-y-6" do |f| %>
  <div class="card space-y-4 p-6">
    <div>
      <h2 class="font-display text-lg font-semibold">Identidad</h2>
      <p class="mt-1 text-xs text-ink-faint">Nombre público, URL y plantilla del formulario de captación.</p>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <%= f.label :name, class: "label" %>
        <%= f.text_field :name, class: "input mt-1 w-full", required: true %>
      </div>
      <div>
        <%= f.label :slug, "Slug (URL pública)", class: "label" %>
        <%= f.text_field :slug, class: "input mt-1 w-full", placeholder: "contacto-curso-ia" %>
        <p class="mt-1 text-xs text-ink-faint">Se usará en /f/slug. Solo letras minúsculas, números y guiones.</p>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <%= f.label :template_key, "Plantilla del formulario", class: "label" %>
        <%= f.select :template_key, options_for_select(@template_keys, lead_form.template_key), {}, class: "input mt-1 w-full" %>
      </div>
      <div class="flex flex-col justify-end gap-3 pb-1">
        <label class="flex items-center gap-2 text-sm">
          <%= f.check_box :collects_company %> Recoger datos de empresa (nombre y CIF)
        </label>
        <label class="flex items-center gap-2 text-sm">
          <%= f.check_box :active %> Activo
        </label>
      </div>
    </div>
  </div>

  <div class="card space-y-4 p-6" data-controller="pipeline-stage-select">
    <div>
      <h2 class="font-display text-lg font-semibold">CRM y asignación</h2>
      <p class="mt-1 text-xs text-ink-faint">Pipeline, etapa y responsable de los deals creados desde este formulario.</p>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <%= f.label :pipeline_id, "Pipeline por defecto", class: "label" %>
        <%= f.collection_select :pipeline_id, @pipelines, :id, :name, {},
              class: "input mt-1 w-full",
              data: { pipeline_stage_select_target: "pipeline", action: "change->pipeline-stage-select#pipelineChanged" } %>
        <p class="mt-1 text-xs text-ink-faint">Pipeline por defecto para deals nuevos. Si el formulario envía <code class="text-2xs">help_type</code>, puede enrutarse según la tabla inferior.</p>
      </div>
      <div>
        <%= f.label :pipeline_stage_id, "Etapa", class: "label" %>
        <%= f.select :pipeline_stage_id,
              options_for_select(
                @pipelines.flat_map { |p|
                  p.pipeline_stages.ordered.map { |s|
                    [ s.name, s.id, { data: { pipeline_id: p.id } } ]
                  }
                },
                lead_form.pipeline_stage_id
              ),
              { include_blank: "Primera etapa del pipeline" },
              class: "input mt-1 w-full",
              data: { pipeline_stage_select_target: "stage" } %>
        <p class="mt-1 text-xs text-ink-faint">Opcional. Los deals nuevos se crean en esta etapa; los deals abiertos existentes avanzan hasta ella (nunca retroceden).</p>
      </div>
    </div>
    <div class="max-w-md">
      <%= f.label :responsible_id, "Responsable", class: "label" %>
      <%= f.collection_select :responsible_id, @responsibles, :id, :name, {}, class: "input mt-1 w-full" %>
    </div>
    <div class="max-w-md">
      <%= f.label :product_id, "Producto (opcional)", class: "label" %>
      <%= f.collection_select :product_id, @products, :id, :name,
            { include_blank: "Ninguno" },
            class: "input mt-1 w-full" %>
      <p class="mt-1 text-xs text-ink-faint">Si se configura, se envía oculto en el formulario público y se asocia al deal. Puede sobrescribirse con <code class="text-2xs">?product_id=</code> en la URL.</p>
    </div>

    <div class="space-y-3 border-t border-line pt-4" data-controller="nested-form">
      <%= hidden_field_tag "lead_form[pipeline_routes_submitted]", "1" %>
      <div>
        <p class="text-sm font-medium text-ink">Pipeline según campo del formulario</p>
        <p class="mt-1 text-xs text-ink-faint">Opcional. Si la plantilla envía un campo (p. ej. <code class="text-2xs">help_type</code>), asigna un pipeline distinto por <strong>valor</strong> del POST. Las claves deben coincidir con los <code class="text-2xs">value</code> del atributo <code class="text-2xs">choices:</code> en Liquid.</p>
      </div>
      <div class="space-y-2" data-nested-form-target="list">
        <% lead_form.pipeline_routes.each do |key, pipeline_id| %>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end" data-nested-form-target="row">
            <div class="flex-1">
              <%= label_tag nil, "Valor del campo", class: "label" %>
              <%= text_field_tag "lead_form[pipeline_route_keys][]", key,
                    class: "input mt-1 w-full font-mono text-sm",
                    placeholder: "curso",
                    pattern: LeadForm::FIELD_KEY_FORMAT.source,
                    title: "Letras minúsculas, números y guiones bajos" %>
            </div>
            <div class="flex-1">
              <%= label_tag nil, "Pipeline", class: "label" %>
              <%= select_tag "lead_form[pipeline_route_pipeline_ids][]",
                    options_from_collection_for_select(@pipelines, :id, :name, pipeline_id),
                    include_blank: "Usar pipeline por defecto",
                    class: "input mt-1 w-full" %>
            </div>
            <button type="button" class="btn-ghost shrink-0" data-action="nested-form#remove" aria-label="Quitar ruta">✕</button>
          </div>
        <% end %>
      </div>
      <template data-nested-form-target="template">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end" data-nested-form-target="row">
          <div class="flex-1">
            <%= label_tag nil, "Valor del campo", class: "label" %>
            <%= text_field_tag "lead_form[pipeline_route_keys][]", nil,
                  class: "input mt-1 w-full font-mono text-sm",
                  placeholder: "curso",
                  pattern: LeadForm::FIELD_KEY_FORMAT.source,
                  title: "Letras minúsculas, números y guiones bajos" %>
          </div>
          <div class="flex-1">
            <%= label_tag nil, "Pipeline", class: "label" %>
            <%= select_tag "lead_form[pipeline_route_pipeline_ids][]",
                  options_from_collection_for_select(@pipelines, :id, :name, nil),
                  include_blank: "Usar pipeline por defecto",
                  class: "input mt-1 w-full" %>
          </div>
          <button type="button" class="btn-ghost shrink-0" data-action="nested-form#remove" aria-label="Quitar ruta">✕</button>
        </div>
      </template>
      <button type="button" class="btn-secondary" data-action="nested-form#add">
        <%= icon :plus, classes: "size-3.5" %> Añadir ruta
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
    <div class="card space-y-4 p-6 min-w-0">
      <div>
        <h2 class="font-display text-lg font-semibold">Primera tarea</h2>
        <p class="mt-1 text-xs text-ink-faint">Se crea al generar un deal nuevo (no al reutilizar uno abierto).</p>
      </div>
      <div>
        <%= f.label :first_task_title, "Texto de la primera tarea", class: "label" %>
        <%= f.text_field :first_task_title, class: "input mt-1 w-full", required: true %>
      </div>
      <div class="max-w-xs">
        <%= f.label :first_task_due_days, "Vence en (días desde la creación del deal)", class: "label" %>
        <%= f.number_field :first_task_due_days, class: "input mt-1 w-full", min: 0, required: true %>
        <p class="mt-1 text-xs text-ink-faint">Al enviar el formulario y crear el deal, la tarea vence N días después (0 = el mismo día).</p>
      </div>
    </div>

    <div class="card space-y-4 p-6 min-w-0">
      <div>
        <h2 class="font-display text-lg font-semibold">Email y redirección</h2>
        <p class="mt-1 text-xs text-ink-faint">Comunicación automática al lead y destino tras el envío.</p>
      </div>
      <div>
        <%= f.label :email_template_id, "Plantilla de email al lead", class: "label" %>
        <div
          class="mt-1 flex items-center gap-2"
          data-controller="email-template-select"
          data-email-template-select-url-template-value="<%= edit_email_template_path("__ID__") %>"
        >
          <%= f.collection_select :email_template_id, @email_templates, :id, :name, { include_blank: "Sin email" }, class: "input w-full min-w-0", data: { email_template_select_target: "select", action: "change->email-template-select#update" } %>
          <% selected_template = lead_form.email_template %>
          <%= link_to(
                selected_template ? edit_email_template_path(selected_template) : "#",
                target: "_blank",
                rel: "noopener noreferrer",
                class: "inline-flex shrink-0 text-ink-faint hover:text-ink focus:outline-none focus-visible:text-ink #{'invisible pointer-events-none' unless selected_template}",
                data: { email_template_select_target: "link" },
                aria: { label: "Abrir plantilla de email en otra pestaña" }
              ) { icon(:external, classes: "size-4") } %>
          <%= info_tooltip(lead_form_email_template_tokens_hint, label: "Tokens disponibles en la plantilla de email") %>
        </div>
        <p class="mt-1 text-xs text-ink-faint">Si eliges «Sin email», no se envía correo automático al lead tras el envío.</p>
      </div>
      <div>
        <%= f.label :success_redirect_url, "URL de redirección tras envío", class: "label" %>
        <%= f.url_field :success_redirect_url, class: "input mt-1 w-full", placeholder: "https://entaina.com/gracias" %>
        <p class="mt-1 text-xs text-ink-faint">Opcional. Si se deja vacío, se muestra la página de gracias de Cream (/f/slug/success).</p>
      </div>
    </div>
  </div>

  <div class="card space-y-4 p-6">
    <div>
      <h2 class="font-display text-lg font-semibold">Campos ocultos</h2>
      <p class="mt-1 text-xs text-ink-faint">Parámetros adicionales leídos de la URL pública (p. ej. /f/slug?producto=curso-ia).</p>
    </div>
    <div class="max-w-xl">
      <%= f.label :hidden_field_keys_text, "Claves adicionales", class: "label" %>
      <%= f.text_area :hidden_field_keys_text, class: "input mt-1 w-full font-mono text-sm", rows: 4, placeholder: "producto\nlanding" %>
      <p class="mt-1 text-xs text-ink-faint">Una clave por línea.</p>
    </div>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to "Cancelar", lead_forms_path, class: "btn-secondary" %>
  </div>
<% end %>
