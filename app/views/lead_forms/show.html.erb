<% page_title @lead_form.name %>
<% actions = capture do %>
  <%= link_to "Editar", edit_lead_form_path(@lead_form), class: "btn-secondary" %>
<% end %>
<%= render "shared/page_header", title: @lead_form.name, icon_name: :globe, actions: actions %>

<div class="px-5 py-4 space-y-6">
  <div class="flex flex-wrap gap-3 text-sm">
    <span class="badge"><%= @lead_form.destination == "mql" ? "Destino MQL" : "Destino Deal" %></span>
    <%= link_to @lead_form.public_url, @lead_form.public_url, class: "text-accent hover:underline", target: "_blank", rel: "noopener" %>
  </div>

  <div class="card p-4">
    <h2 class="font-semibold mb-3">MQL captados (<%= @mql_people.count %> personas)</h2>
    <% if @mql_people.any? %>
      <table class="table-base">
        <thead>
          <tr>
            <th>Persona</th>
            <th>Envíos</th>
            <th>Primera captura</th>
            <th>Última captura</th>
            <th>Elegible ahora</th>
          </tr>
        </thead>
        <tbody>
          <% @mql_people.each do |row| %>
            <tr>
              <td><%= link_to row[:person].display_name, row[:person], class: "font-medium hover:text-accent" %></td>
              <td><%= row[:submission_count] %></td>
              <td><%= l(row[:first_at], format: :short) %></td>
              <td><%= l(row[:last_at], format: :short) %></td>
              <td><%= row[:eligible] ? "Sí" : "No" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-ink-soft">Aún no hay capturas MQL desde este formulario.</p>
    <% end %>
  </div>

  <div class="card p-4">
    <h2 class="font-semibold mb-3">Envíos recientes</h2>
    <% if @submissions.any? %>
      <table class="table-base">
        <thead>
          <tr>
            <th>Persona</th>
            <th>Destino</th>
            <th>Fecha</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @submissions.each do |submission| %>
            <tr>
              <td><%= link_to submission.person.display_name, submission.person, class: "hover:text-accent" %></td>
              <td><%= submission.capture_destination.upcase %></td>
              <td><%= l(submission.created_at, format: :short) %></td>
              <td><%= link_to "Detalle", person_lead_submission_path(submission.person, submission), class: "text-accent text-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagination", pagy: @submissions_pagy if @submissions_pagy %>
    <% else %>
      <p class="text-sm text-ink-soft">Sin envíos todavía.</p>
    <% end %>
  </div>
</div>
