<p>Hola <%= @responsible.name %>,</p>

<p>Se ha recibido un nuevo envío en el formulario <strong><%= @lead_form.name %></strong>.</p>

<h2>Datos del formulario</h2>
<ul>
  <% @data.each do |key, value| %>
    <li><strong><%= key.humanize %>:</strong> <%= value %></li>
  <% end %>
</ul>

<% if @metadata.present? %>
  <h2>Origen</h2>
  <ul>
    <% @metadata.each do |key, value| %>
      <li><strong><%= key.humanize %>:</strong> <%= value %></li>
    <% end %>
  </ul>
<% end %>

<p>
  <%= link_to "Ver deal en Cream", deal_url(@deal) %>
</p>
