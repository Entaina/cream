<% page_title "Tipos de suscripción" %>
<% actions = capture do %>
  <%= link_to new_subscription_type_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nuevo tipo
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Tipos de suscripción", icon_name: :mail, count: @subscription_types.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @subscription_types.empty? %>
    <%= render "shared/empty_state", icon_name: :mail, title: "Sin tipos de suscripción",
          subtitle: "Define categorías de comunicación (newsletter, promociones, etc.) para gestionar el consentimiento." %>
  <% else %>
    <% @subscription_types.each do |type| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base"><%= type.name %></h2>
          <%= badge type.active? ? "Activo" : "Inactivo", color: type.active? ? "green" : "chicago" %>
          <span class="text-sm text-ink-faint font-mono"><%= type.slug %></span>
          <div class="ml-auto flex gap-2">
            <%= link_to "Editar", edit_subscription_type_path(type), class: "btn-secondary" %>
            <%= button_to "Eliminar", subscription_type_path(type), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: "¿Eliminar el tipo «#{type.name}»?" } } %>
          </div>
        </div>
        <% if type.description.present? %>
          <p class="text-sm text-ink-faint mt-1"><%= type.description %></p>
        <% end %>
      </article>
    <% end %>
  <% end %>
</div>
