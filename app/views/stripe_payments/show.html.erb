<% page_title "Stripe payment" %>
<%
  status_labels = { "pending_review" => [ "To review", "golden" ], "matched" => [ "Matched", "green" ], "ignored" => [ "Ignored", "chicago" ] }
  status_label, status_color = status_labels.fetch(@payment.status)
  amount = number_to_currency(@payment.amount_decimal,
    unit: @payment.currency.casecmp?("eur") ? "€" : @payment.currency.upcase,
    precision: 2, delimiter: ".", separator: ",", format: "%n %u")
%>
<% actions = capture do %>
  <%= link_to stripe_payments_path(status: @payment.status), class: "btn-secondary" do %>
    <%= icon :arrow_left, classes: "size-3.5" %> Payments
  <% end %>
  <% if @payment.receipt_url.present? %>
    <%= link_to @payment.receipt_url, target: "_blank", rel: "noopener", class: "btn-secondary" do %>
      <%= icon :external, classes: "size-3.5" %> Stripe receipt
    <% end %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Payment #{amount} — #{@payment.customer_name.presence || @payment.customer_email}",
      icon_name: :credit_card, actions: actions %>

<div class="flex-1 flex min-h-0 overflow-x-auto snap-x snap-mandatory md:overflow-x-visible md:snap-none">
  <aside class="w-80 shrink-0 snap-start border-r border-line overflow-y-auto scrollbar-subtle p-4 space-y-0.5">
    <div class="flex items-center gap-2 px-1 pb-2">
      <%= badge status_label, color: status_color %>
      <%= badge "Refunded", color: "red" if @payment.refunded? %>
      <%= badge "Partially refunded (#{number_to_currency(@payment.amount_refunded_decimal, unit: "€", format: "%n %u", delimiter: ".", separator: ",")})", color: "orange" if @payment.partially_refunded? %>
      <%= badge "Test mode", color: "chicago" unless @payment.livemode? %>
    </div>
    <%= render "shared/attribute", label: "Amount", icon_name: :banknote, value: amount %>
    <%= render "shared/attribute", label: "Paid at", icon_name: :calendar, value: l(@payment.paid_at, format: :long) %>
    <%= render "shared/attribute", label: "Name", icon_name: :users, value: @payment.customer_name %>
    <%= render "shared/attribute", label: "Email", icon_name: :mail, value: @payment.customer_email %>
    <%= render "shared/attribute", label: "Phone", icon_name: :phone, value: @payment.customer_phone %>
    <%= render "shared/attribute", label: "Address", icon_name: :map_pin, value: @payment.billing_address %>
    <%= render "shared/attribute", label: "Paid with", icon_name: :credit_card, value: @payment.payment_method_summary %>
    <%= render "shared/attribute", label: "Description", icon_name: :note, value: @payment.description %>
    <%= render "shared/attribute", label: "Risk check", icon_name: :check_circle, value: @payment.risk_outcome %>
    <div class="pt-3 mt-2 border-t border-line space-y-0.5">
      <%= render "shared/attribute", label: "Charge id", icon_name: :list, value: tag.span(@payment.stripe_charge_id, class: "font-mono text-sm") %>
      <%= render "shared/attribute", label: "Customer id", icon_name: :list, value: (tag.span(@payment.stripe_customer_id, class: "font-mono text-sm") if @payment.stripe_customer_id.present?) %>
      <%= render "shared/attribute", label: "Intent id", icon_name: :list, value: (tag.span(@payment.stripe_payment_intent_id, class: "font-mono text-sm") if @payment.stripe_payment_intent_id.present?) %>
    </div>
  </aside>

  <div class="w-full shrink-0 snap-start md:flex-1 md:w-auto overflow-y-auto scrollbar-subtle p-5 space-y-4 max-w-3xl">
    <section class="card p-4 space-y-3">
      <h2 class="text-base font-semibold">Reconciliation</h2>
      <% if @payment.matched? && @payment.deal %>
        <p class="text-base text-ink-soft">
          Linked to <%= link_to @payment.deal.name, deal_path(@payment.deal), class: "text-accent hover:underline" %>
          <% if @payment.matched_by %>by <%= @payment.matched_by.name %><% end %>
          <% if @payment.matched_at %>on <%= l(@payment.matched_at, format: :short) %><% end %>.
        </p>
      <% elsif @payment.ignored? %>
        <p class="text-base text-ink-soft">This payment is ignored.</p>
        <%= button_to "Restore to review", unignore_stripe_payment_path(@payment), method: :post, class: "btn-secondary" %>
      <% else %>
        <% if @payment.suggested_deal %>
          <p class="text-base text-ink-soft">
            Suggestion (<%= @payment.match_confidence %>):
            <%= link_to @payment.suggested_deal.name, deal_path(@payment.suggested_deal), class: "text-accent hover:underline" %>
          </p>
          <%= button_to "Accept suggestion", match_stripe_payment_path(@payment), method: :post, class: "btn-primary" %>
        <% elsif @payment.suggested_person %>
          <p class="text-base text-ink-soft">
            Payer identified as <%= link_to @payment.suggested_person.display_name, person_path(@payment.suggested_person), class: "text-accent hover:underline" %>,
            but no open deal was found.
          </p>
        <% else %>
          <p class="text-base text-ink-faint">No person in the CRM matches this payer's email.</p>
        <% end %>
        <div class="flex items-center gap-2 flex-wrap">
          <%= render "link_deal_form", payment: @payment, input_class: "input h-8 text-sm w-72" %>
          <%= link_to "Create deal", new_deal_path(stripe_payment_id: @payment.id,
                person_id: @payment.suggested_person_id, company_id: @payment.suggested_person&.company_id),
                class: "btn-secondary" %>
          <%= button_to "Ignore", ignore_stripe_payment_path(@payment), method: :post, class: "btn-ghost" %>
        </div>
      <% end %>
    </section>

    <% if @payment.metadata.present? %>
      <section class="card p-4">
        <h2 class="text-base font-semibold mb-2">Stripe metadata</h2>
        <table class="w-full text-sm">
          <% @payment.metadata.each do |key, value| %>
            <tr class="border-t border-line first:border-t-0">
              <td class="py-1.5 pr-4 text-ink-faint font-mono whitespace-nowrap align-top"><%= key %></td>
              <td class="py-1.5 break-all"><%= value %></td>
            </tr>
          <% end %>
        </table>
      </section>
    <% end %>

    <% if @payment.payload.present? %>
      <details class="card p-4">
        <summary class="text-base font-semibold cursor-pointer select-none">Full Stripe data</summary>
        <pre class="mt-3 text-xs leading-relaxed font-mono bg-canvas-sunken rounded-lg p-3 overflow-x-auto max-h-[32rem] overflow-y-auto"><%= JSON.pretty_generate(@payment.payload) %></pre>
      </details>
    <% end %>
  </div>
</div>
