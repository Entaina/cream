<% page_title "Stripe payments" %>
<% actions = capture do %>
  <%= link_to stripe_connection_path, class: "btn-secondary" do %>
    <%= icon :settings, classes: "size-3.5" %> Stripe settings
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Stripe payments", icon_name: :credit_card,
      count: @counts.values.sum, actions: actions %>

<div class="flex-1 flex flex-col min-h-0">
  <div class="flex flex-wrap items-center gap-3 border-b border-line px-5 py-2">
    <nav class="flex gap-1 text-base">
      <% { "pending_review" => "To review", "matched" => "Matched", "ignored" => "Ignored" }.each do |status, label| %>
        <%= link_to stripe_payments_path(status: status, q: params[:q].presence),
              class: "px-2.5 py-1 rounded-md #{@status == status ? 'bg-canvas-sunken font-medium text-ink' : 'text-ink-soft hover:bg-canvas-soft'}" do %>
          <%= label %>
          <span class="text-ink-faint tabular-nums"><%= @counts.fetch(status, 0) %></span>
        <% end %>
      <% end %>
    </nav>
    <%= form_with url: stripe_payments_path, method: :get, class: "md:ml-auto flex items-center gap-2 w-full md:w-auto" do %>
      <%= hidden_field_tag :status, @status %>
      <%= search_field_tag :q, params[:q], placeholder: "Search email, name, description…", class: "input h-8 w-full md:w-64" %>
    <% end %>
  </div>

  <div class="flex-1 overflow-auto scrollbar-subtle">
    <% if @connection.nil? %>
      <div class="p-8 text-center text-base text-ink-faint">
        Stripe is not connected yet.
        <%= link_to "Connect Stripe", stripe_connection_path, class: "text-accent underline" %> to import payments.
      </div>
    <% elsif @payments.empty? %>
      <div class="p-8 text-center text-base text-ink-faint">No payments here.</div>
    <% else %>
      <table class="table-base">
        <thead>
          <tr>
            <th>Date</th>
            <th class="text-right">Amount</th>
            <th>Customer</th>
            <th>Description</th>
            <th>Deal</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "payment_row", collection: @payments, as: :payment %>
        </tbody>
      </table>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy if @pagy %>
</div>
