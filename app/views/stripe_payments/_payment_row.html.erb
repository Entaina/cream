<%# locals: (payment:) %>
<% confidence_colors = { "high" => "green", "medium" => "golden", "low" => "chicago" } %>
<tr class="cursor-pointer" onclick="Turbo.visit('<%= stripe_payment_path(payment) %>')">
  <td class="whitespace-nowrap text-ink-soft"><%= l(payment.paid_at, format: :short) %></td>
  <td class="text-right tabular-nums font-medium whitespace-nowrap">
    <%= number_to_currency(payment.amount_decimal,
          unit: payment.currency.casecmp?("eur") ? "€" : payment.currency.upcase,
          precision: 2, delimiter: ".", separator: ",", format: "%n %u") %>
    <%= badge("Refunded", color: "red") if payment.refunded? %>
    <%= badge("Test", color: "chicago") unless payment.livemode? %>
  </td>
  <td class="max-w-56">
    <div class="truncate"><%= payment.customer_name.presence || "—" %></div>
    <div class="text-sm text-ink-faint truncate"><%= payment.customer_email %></div>
  </td>
  <td class="max-w-64 text-ink-soft"><div class="truncate"><%= payment.description %></div></td>
  <td onclick="event.stopPropagation()">
    <% if payment.matched? && payment.deal %>
      <%= link_to payment.deal.name, deal_path(payment.deal), class: "text-accent hover:underline" %>
    <% elsif payment.pending_review? && payment.suggested_deal %>
      <div class="flex items-center gap-1.5">
        <%= badge(payment.match_confidence, color: confidence_colors.fetch(payment.match_confidence, "chicago")) %>
        <%= link_to payment.suggested_deal.name, deal_path(payment.suggested_deal),
              class: "text-accent hover:underline truncate max-w-48" %>
      </div>
    <% elsif payment.suggested_person %>
      <span class="text-sm text-ink-faint">
        <%= link_to payment.suggested_person.display_name, person_path(payment.suggested_person),
              class: "text-accent hover:underline" %> · no open deal
      </span>
    <% else %>
      <span class="text-sm text-ink-faint">No match</span>
    <% end %>
  </td>
  <td onclick="event.stopPropagation()">
    <div class="flex items-center gap-1.5 justify-end flex-wrap">
      <% if payment.pending_review? %>
        <% if payment.suggested_deal %>
          <%= button_to "Accept", match_stripe_payment_path(payment, status: params[:status], q: params[:q].presence),
                method: :post, class: "btn-primary" %>
        <% end %>
        <%= render "link_deal_form", payment: payment %>
        <%= link_to "Create deal",
              new_deal_path(stripe_payment_id: payment.id, person_id: payment.suggested_person_id,
                company_id: payment.suggested_person&.company_id),
              class: "btn-secondary" %>
        <%= button_to "Ignore", ignore_stripe_payment_path(payment, status: params[:status], q: params[:q].presence),
              method: :post, class: "btn-ghost" %>
      <% elsif payment.ignored? %>
        <%= button_to "Restore", unignore_stripe_payment_path(payment, status: params[:status], q: params[:q].presence),
              method: :post, class: "btn-secondary" %>
      <% end %>
    </div>
  </td>
</tr>
