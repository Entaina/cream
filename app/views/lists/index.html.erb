<% page_title "Lists" %>
<% actions = capture do %>
  <%= link_to new_list_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> New list
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Lists", icon_name: :list, count: @lists.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <% if @lists.any? %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 max-w-4xl">
      <% @lists.each do |list| %>
        <%= link_to list_path(list), class: "card p-4 hover:border-line-strong transition-colors" do %>
          <div class="flex items-center gap-2 mb-2">
            <span class="size-2.5 rounded-full bg-<%= list.color %>-500"></span>
            <span class="font-medium text-base"><%= list.name %></span>
          </div>
          <p class="text-sm text-ink-faint">
            <%= pluralize(list.list_entries.size, list.record_type.downcase) %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <% action = capture do %>
      <%= link_to new_list_path, class: "btn-primary" do %>
        <%= icon :plus, classes: "size-3.5" %> New list
      <% end %>
    <% end %>
    <%= render "shared/empty_state", icon_name: :list, title: "No lists yet",
          subtitle: "Lists let you group people, companies or deals for campaigns, segments or anything else.",
          action: action %>
  <% end %>
</div>
