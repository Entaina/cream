<% page_title "Team" %>
<%= render "shared/page_header", title: "Team", icon_name: :users, count: @memberships.size, actions: nil %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-2xl space-y-6">
    <p class="text-base text-ink-soft">
      Manage workspace members, roles, and invitations for <strong><%= current_workspace.name %></strong>.
    </p>

    <% if flash[:invitation_link].present? %>
      <div class="card p-4 border-green-200 bg-green-50 dark:border-green-800 dark:bg-green-950">
        <p class="text-base font-medium text-ink mb-2">Invitation link (copy and share):</p>
        <code class="block text-sm font-mono bg-canvas-raised border border-line rounded-md px-3 py-2 break-all select-all"><%= flash[:invitation_link] %></code>
      </div>
    <% end %>

    <% if @admin %>
      <section class="card p-4 space-y-3">
        <h2 class="text-base font-semibold text-ink">Workspace settings</h2>
        <%= form_with model: current_workspace, url: settings_team_path, method: :patch, class: "space-y-3" do |f| %>
          <div class="flex items-end gap-2">
            <div class="flex-1">
              <%= f.label :name, "Workspace name", class: "block text-sm font-medium text-ink-soft mb-1" %>
              <%= f.text_field :name, class: "input w-full" %>
            </div>
            <%= f.submit "Save", class: "btn-secondary" %>
          </div>
          <% if feature_enabled?(:sales_director) %>
            <label class="flex items-center gap-2 text-base">
              <%= f.check_box :sales_director_enabled %>
              Briefing diario del director de ventas (IA)
            </label>
            <% unless Ai::Configuration.configured? %>
              <p class="text-sm text-ink-faint">Requiere configurar <code>CREAM_AI_API_KEY</code> en el servidor.</p>
            <% end %>
          <% end %>
        <% end %>
      </section>

      <section class="card p-4 space-y-3">
        <h2 class="text-base font-semibold text-ink">Invite member</h2>
        <%= form_with url: invitations_path, class: "flex flex-wrap items-end gap-2" do %>
          <div class="flex-1 min-w-[12rem]">
            <label for="invitation_email_address" class="block text-sm font-medium text-ink-soft mb-1">Email</label>
            <input type="email" name="invitation[email_address]" id="invitation_email_address" required placeholder="colleague@company.com" class="input w-full">
          </div>
          <div>
            <label for="invitation_role" class="block text-sm font-medium text-ink-soft mb-1">Role</label>
            <select name="invitation[role]" id="invitation_role" class="input">
              <% Membership::ROLES.each do |role| %>
                <option value="<%= role %>"><%= Membership::ROLE_LABELS[role] %></option>
              <% end %>
            </select>
          </div>
          <%= submit_tag "Send invitation", class: "btn-primary" %>
        <% end %>
      </section>
    <% end %>

    <section class="space-y-2">
      <h2 class="text-base font-semibold text-ink px-1">Members</h2>
      <ul class="space-y-2">
        <% @memberships.each do |membership| %>
          <li class="card flex items-center gap-3 px-4 py-3">
            <%= avatar membership.user, size: "size-8", text: "text-sm" %>
            <div class="min-w-0 flex-1">
              <p class="text-base font-medium truncate"><%= membership.user.name %></p>
              <p class="text-xs text-ink-faint truncate"><%= membership.user.email_address %></p>
            </div>
            <% if @admin && membership.user_id != current_user.id %>
              <%= form_with model: membership, url: membership_path(membership), method: :patch, class: "flex items-center gap-2" do |f| %>
                <%= f.select :role, Membership::ROLES.map { |r| [ Membership::ROLE_LABELS[r], r ] }, {}, class: "input text-sm py-1", onchange: "this.form.requestSubmit()" %>
              <% end %>
              <%= button_to membership_path(membership), method: :delete,
                    class: "text-ink-faint hover:text-danger p-1.5 rounded-md hover:bg-danger-soft",
                    title: "Remove member" do %>
                <%= icon :trash, classes: "size-4" %>
              <% end %>
            <% else %>
              <span class="text-sm font-medium text-ink-soft"><%= membership.role_label %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <% if @pending_invitations.any? %>
      <section class="space-y-2">
        <h2 class="text-base font-semibold text-ink px-1">Pending invitations</h2>
        <ul class="space-y-2">
          <% @pending_invitations.each do |invitation| %>
            <li class="card flex items-center gap-3 px-4 py-3">
              <div class="min-w-0 flex-1">
                <p class="text-base font-medium truncate"><%= invitation.email_address %></p>
                <p class="text-xs text-ink-faint mt-0.5">
                  Invited as <%= invitation.role_label %>
                  · expires <%= l invitation.expires_at, format: :short %>
                </p>
              </div>
              <% if @admin %>
                <%= button_to resend_invitation_path(invitation), method: :post,
                      class: "btn-ghost text-sm",
                      title: "Resend invitation" do %>
                  Resend
                <% end %>
                <%= button_to invitation_path(invitation), method: :delete,
                      class: "text-ink-faint hover:text-danger p-1.5 rounded-md hover:bg-danger-soft",
                      title: "Revoke invitation" do %>
                  <%= icon :trash, classes: "size-4" %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
