<%= form_with model: custom_field, url: custom_field.persisted? ? settings_custom_field_path(custom_field) : settings_custom_fields_path,
      class: "space-y-4 card p-4" do |f| %>
  <% if custom_field.errors.any? %>
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <ul class="list-disc list-inside">
        <% custom_field.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input", autofocus: true, placeholder: "Customer tier" %>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :record_type, "Object", class: "label" %>
      <% if custom_field.persisted? %>
        <%= f.hidden_field :record_type %>
        <p class="input bg-canvas-sunken text-ink-soft"><%= custom_field.record_type %></p>
      <% else %>
        <%= f.select :record_type, CustomField::RECORD_TYPES, {}, class: "input" %>
      <% end %>
    </div>
    <div>
      <%= f.label :field_type, "Type", class: "label" %>
      <% field_types = CustomField::FIELD_TYPES %>
      <% field_types = field_types - [ "formula" ] unless feature_enabled?(:formula_fields) %>
      <%= f.select :field_type, field_types.map { |t| [t.humanize, t] }, {},
            class: "input",
            onchange: "document.getElementById('custom-field-options-panel').classList.toggle('hidden', !['select','multi_select'].includes(this.value)); document.getElementById('custom-field-formula-panel').classList.toggle('hidden', this.value !== 'formula'); document.getElementById('custom-field-reference-panel').classList.toggle('hidden', this.value !== 'record_reference')" %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :required, class: "rounded border-line" %>
    <%= f.label :required, "Required on create and edit", class: "text-base text-ink-soft" %>
  </div>

  <div id="custom-field-formula-panel" class="<%= custom_field.formula? ? '' : 'hidden' %>">
    <% if feature_enabled?(:formula_fields) %>
      <%= f.label :formula_expression, "Formula expression", class: "label" %>
      <%= f.text_field :formula_expression, class: "input", placeholder: "{value} * {probability} / 100" %>
      <p class="mt-1 text-xs text-ink-faint">Use {field_name} or {cf.key} tokens. Supports +, -, *, / and parentheses.</p>
    <% end %>
  </div>

  <div id="custom-field-reference-panel" class="<%= custom_field.reference? ? '' : 'hidden' %>">
    <%= f.label :reference_type, "Related object", class: "label" %>
    <%= f.select :reference_type, CustomField::RECORD_TYPES, { include_blank: "Select object…" }, class: "input" %>
    <p class="mt-1 text-xs text-ink-faint">Records of this type can be linked from the field.</p>
  </div>

  <div id="custom-field-options-panel" class="<%= custom_field.select? ? '' : 'hidden' %>">
    <%= label_tag :custom_field_options_text, "Options (one per line)", class: "label" %>
    <%= text_area_tag "custom_field[options_text]",
          custom_field.options&.join("\n"),
          rows: 4, class: "input font-mono text-sm" %>
    <p class="mt-1 text-xs text-ink-faint">Used for select and multi-select fields.</p>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit custom_field.persisted? ? "Save changes" : "Create field", class: "btn-primary" %>
    <%= link_to "Cancel", settings_custom_fields_path, class: "btn-secondary" %>
  </div>
<% end %>
