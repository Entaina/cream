<% page_title "Settings" %>
<%= render "shared/page_header", title: "Settings", icon_name: :settings, actions: nil %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-2xl space-y-6">
    <p class="text-base text-ink-soft">
      Configure workspace options for <strong><%= current_workspace.name %></strong>.
    </p>

    <section class="card p-4 space-y-3">
      <h2 class="text-base font-semibold text-ink">General</h2>
      <%= form_with model: current_workspace, url: settings_workspace_path, method: :patch, class: "space-y-3" do |f| %>
        <div class="flex items-end gap-2">
          <div class="flex-1">
            <%= f.label :name, "Workspace name", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.text_field :name, class: "input w-full" %>
          </div>
          <%= f.submit "Save", class: "btn-secondary" %>
        </div>
        <label class="flex items-center gap-2 text-base">
          <%= f.check_box :salespeople_can_view_all_deals %>
          Los vendedores pueden ver los deals de otros
        </label>
        <label class="flex items-center gap-2 text-base">
          <%= f.check_box :salespeople_can_edit_all_deals %>
          Los vendedores pueden editar los deals de otros
        </label>
        <p class="text-sm text-ink-faint">Si solo activas editar, los vendedores también podrán ver esos deals.</p>
        <% if feature_enabled?(:sales_director) %>
          <label class="flex items-center gap-2 text-base">
            <%= f.check_box :sales_director_enabled %>
            Briefing diario del director de ventas (IA)
          </label>
          <% unless Ai::Configuration.configured? %>
            <p class="text-sm text-ink-faint">Requiere configurar <code>CREAM_AI_API_KEY</code> en el servidor.</p>
          <% end %>
        <% end %>
      <% end %>
    </section>

    <% if feature_enabled?(:okm_chat) %>
      <section class="card p-4 space-y-3">
        <h2 class="text-base font-semibold text-ink">OKM</h2>
        <p class="text-sm text-ink-soft">
          Conecta el OKM corporativo (Google Shared Drive) para el chat contextual y los briefings de IA.
        </p>
        <%= form_with model: current_workspace, url: settings_workspace_path, method: :patch, class: "space-y-3" do |f| %>
          <label class="flex items-center gap-2 text-base">
            <%= f.check_box :okm_chat_enabled %>
            Habilitar chat OKM en este workspace
          </label>
          <% unless Ai::Configuration.configured? %>
            <p class="text-sm text-ink-faint">Requiere configurar <code>CREAM_AI_API_KEY</code> en el servidor.</p>
          <% end %>
          <div>
            <%= f.label :okm_drive_id, "Google Shared Drive ID", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.text_field :okm_drive_id, class: "input w-full font-mono text-sm", placeholder: "0AxxxxxxxxxxxxUk9PVA" %>
            <p class="text-sm text-ink-faint mt-1">ID del shared drive desde la URL de Google Drive.</p>
          </div>
          <div>
            <%= f.label :okm_service_account_key, "Service account JSON", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <% if current_workspace.okm_configured? %>
              <p class="text-sm text-green-700 dark:text-green-400 mb-2">
                Configurada: <%= current_workspace.okm_service_account_client_email %>
              </p>
            <% end %>
            <%= f.text_area :okm_service_account_key,
                  class: "input w-full font-mono text-xs min-h-[8rem]",
                  placeholder: "Pega aquí el JSON de la service account con acceso de lectura al drive…",
                  value: "" %>
            <p class="text-sm text-ink-faint mt-1">Deja en blanco para conservar la clave actual. El JSON no se vuelve a mostrar.</p>
          </div>
          <%= f.submit "Save OKM settings", class: "btn-secondary" %>
        <% end %>
      </section>
    <% end %>

    <% if feature_enabled?(:marketing_consent) %>
      <% @beehiiv_connection ||= current_workspace.beehiiv_connection || current_workspace.build_beehiiv_connection(user: current_user) %>
      <section class="card p-4 space-y-3">
        <h2 class="text-base font-semibold text-ink">Beehiiv</h2>
        <p class="text-sm text-ink-soft">
          Sincroniza la audiencia de Beehiiv con el tipo de suscripción <strong>Newsletter</strong> de Cream.
          Beehiiv sigue enviando la newsletter; Cream refleja altas y bajas en el pool MQL.
        </p>

        <% if @beehiiv_connection.errors.any? %>
          <div class="text-sm text-danger">
            <% @beehiiv_connection.errors.full_messages.each do |message| %>
              <p><%= message %></p>
            <% end %>
          </div>
        <% end %>

        <% if @beehiiv_connection.persisted? && @beehiiv_connection.connected? %>
          <p class="text-sm text-green-700 dark:text-green-400">
            Conectado a publicación <strong class="font-mono"><%= @beehiiv_connection.publication_id %></strong>
            con API key <strong class="font-mono"><%= @beehiiv_connection.masked_api_key %></strong>.
            <% if @beehiiv_connection.last_synced_at.present? %>
              Última sync: <%= l(@beehiiv_connection.last_synced_at, format: :short) %>.
            <% end %>
          </p>
          <% if @beehiiv_connection.last_error.present? %>
            <p class="text-sm text-danger">Último error: <%= @beehiiv_connection.last_error %></p>
          <% end %>
        <% end %>

        <%= form_with model: @beehiiv_connection, url: beehiiv_connection_path,
              method: @beehiiv_connection.persisted? ? :patch : :post, class: "space-y-3" do |f| %>
          <div>
            <%= f.label :api_key, "API Key", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.password_field :api_key, value: "", autocomplete: "off", class: "input w-full font-mono",
                  placeholder: @beehiiv_connection.connected? ? "Deja en blanco para conservar la clave actual" : "Clave de la API de Beehiiv" %>
          </div>
          <div>
            <%= f.label :publication_id, "Publication ID", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.text_field :publication_id, class: "input w-full font-mono", placeholder: "pub_00000000-0000-0000-0000-000000000000" %>
          </div>
          <div>
            <%= f.label :webhook_signing_secret, "Webhook signing secret (Svix)", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.password_field :webhook_signing_secret, value: "", autocomplete: "off", class: "input w-full font-mono",
                  placeholder: @beehiiv_connection.webhook_signing_secret.present? ? "Deja en blanco para conservar el secret actual" : "whsec_… (Settings → Webhooks en Beehiiv)" %>
            <p class="text-sm text-ink-faint mt-1">Opcional pero recomendado para webhooks en tiempo real (plan Scale+).</p>
          </div>
          <label class="flex items-center gap-2 text-base">
            <%= f.check_box :sync_enabled %>
            Sincronización automática cada hora
          </label>
          <div class="flex gap-2">
            <%= f.submit @beehiiv_connection.persisted? ? "Guardar Beehiiv" : "Conectar Beehiiv", class: "btn-secondary" %>
          </div>
        <% end %>

        <% if @beehiiv_connection.persisted? %>
          <div class="flex flex-wrap gap-2">
            <%= button_to "Sincronizar ahora", sync_beehiiv_connection_path, method: :post, class: "btn-secondary" %>
            <%= button_to "Desconectar", beehiiv_connection_path, method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: "¿Desconectar Beehiiv de este workspace?" } } %>
          </div>
          <div class="pt-2" data-controller="clipboard">
            <p class="text-sm font-medium text-ink-soft mb-1">URL del webhook</p>
            <p class="text-sm text-ink-faint mb-1">
              En Beehiiv: Settings → Webhooks. Eventos recomendados: subscription.created, subscription.confirmed, subscription.deleted.
            </p>
            <div class="relative">
              <input type="text" readonly value="<%= @beehiiv_connection.webhook_url %>"
                    class="input w-full text-xs font-mono bg-canvas-sunken pr-24 cursor-default"
                    data-clipboard-target="source" tabindex="-1" aria-readonly="true" />
              <div class="absolute top-1.5 right-1.5 flex items-center gap-1">
                <span data-clipboard-target="feedback"
                      class="hidden rounded-md bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-950 dark:text-green-300"
                      role="status" aria-live="polite">Copiado</span>
                <button type="button" class="rounded-md p-1.5 text-ink-faint hover:text-ink hover:bg-canvas-raised"
                      title="Copiar URL" aria-label="Copiar URL"
                      data-action="clipboard#copy" data-clipboard-target="button">
                  <span data-clipboard-target="copyIcon"><%= icon :copy, classes: "size-4" %></span>
                  <span data-clipboard-target="copiedIcon" class="hidden"><%= icon :check, classes: "size-4" %></span>
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if feature_enabled?(:marketing_campaigns) %>
      <% @mailjet_connection ||= current_workspace.mailjet_connection || current_workspace.build_mailjet_connection(user: current_user) %>
      <section class="card p-4 space-y-3">
        <h2 class="text-base font-semibold text-ink">Mailjet</h2>
        <p class="text-sm text-ink-soft">
          Cada workspace usa su propia cuenta de Mailjet para campañas y recorridos. El correo transaccional (invitaciones, alertas, reservas, informes y emails de ficha) solo si lo activas abajo.
        </p>

        <% if @mailjet_connection.errors.any? %>
          <div class="text-sm text-danger">
            <% @mailjet_connection.errors.full_messages.each do |message| %>
              <p><%= message %></p>
            <% end %>
          </div>
        <% end %>

        <% if @mailjet_connection.persisted? && @mailjet_connection.connected? %>
          <p class="text-sm text-green-700 dark:text-green-400">
            Conectado con API key <strong class="font-mono"><%= @mailjet_connection.masked_api_key %></strong>
            y secret <strong class="font-mono"><%= @mailjet_connection.masked_secret_key %></strong>.
          </p>
        <% end %>

        <%= form_with model: @mailjet_connection, url: mailjet_connection_path,
              method: @mailjet_connection.persisted? ? :patch : :post, class: "space-y-3" do |f| %>
          <div>
            <%= f.label :api_key, "API Key", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.password_field :api_key, value: "", autocomplete: "off", class: "input w-full font-mono",
                  placeholder: @mailjet_connection.connected? ? "Deja en blanco para conservar la clave actual" : "Clave pública de Mailjet" %>
          </div>
          <div>
            <%= f.label :secret_key, "Secret Key", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.password_field :secret_key, value: "", autocomplete: "off", class: "input w-full font-mono",
                  placeholder: @mailjet_connection.connected? ? "Deja en blanco para conservar la clave actual" : "Clave secreta de Mailjet" %>
          </div>
          <div>
            <%= f.label :from_email, "Email remitente", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.email_field :from_email, class: "input w-full", placeholder: "noreply@tudominio.com" %>
            <p class="text-sm text-ink-faint mt-1">Debe ser un remitente verificado en Mailjet (SPF/DKIM del dominio).</p>
          </div>
          <div>
            <%= f.label :from_name, "Nombre del remitente", class: "block text-sm font-medium text-ink-soft mb-1" %>
            <%= f.text_field :from_name, class: "input w-full", placeholder: current_workspace.name %>
          </div>
          <label class="flex items-center gap-2 text-base">
            <%= f.check_box :transactional_enabled %>
            Usar Mailjet para el correo transaccional
          </label>
          <p class="text-sm text-ink-faint">
            Invitaciones, alertas, reservas, informes y emails de ficha. Si está desactivado, esos envíos usan SMTP/Mailbin.
          </p>
          <div class="flex gap-2">
            <%= f.submit @mailjet_connection.persisted? ? "Guardar Mailjet" : "Conectar Mailjet", class: "btn-secondary" %>
          </div>
        <% end %>
        <% if @mailjet_connection.persisted? %>
          <%= button_to "Desconectar", mailjet_connection_path, method: :delete, class: "btn-danger",
                form: { data: { turbo_confirm: "¿Desconectar Mailjet de este workspace?" } } %>
          <div class="pt-2" data-controller="clipboard">
            <p class="text-sm font-medium text-ink-soft mb-1">URL del webhook</p>
            <p class="text-sm text-ink-faint mb-1">
              En Mailjet: Account settings → Event Tracking. Misma URL para sent, open, click, bounce, spam, unsub y blocked (Version 2).
            </p>
            <div class="relative">
              <input type="text" readonly value="<%= @mailjet_connection.webhook_url %>"
                    class="input w-full text-xs font-mono bg-canvas-sunken pr-24 cursor-default"
                    data-clipboard-target="source" tabindex="-1" aria-readonly="true" />
              <div class="absolute top-1.5 right-1.5 flex items-center gap-1">
                <span data-clipboard-target="feedback"
                      class="hidden rounded-md bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-950 dark:text-green-300"
                      role="status" aria-live="polite">Copiado</span>
                <button type="button" class="rounded-md p-1.5 text-ink-faint hover:text-ink hover:bg-canvas-raised"
                      title="Copiar URL" aria-label="Copiar URL"
                      data-action="clipboard#copy" data-clipboard-target="button">
                  <span data-clipboard-target="copyIcon"><%= icon :copy, classes: "size-4" %></span>
                  <span data-clipboard-target="copiedIcon" class="hidden"><%= icon :check, classes: "size-4" %></span>
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
