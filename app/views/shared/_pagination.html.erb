<%# locals: (pagy:) %>
<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-between gap-3 border-t border-line px-5 py-2.5 text-sm text-ink-soft"
       aria-label="Pagination">
    <span class="tabular-nums">
      <span class="font-medium text-ink"><%= pagy.from %></span>–<span class="font-medium text-ink"><%= pagy.to %></span>
      de <span class="font-medium text-ink"><%= pagy.count %></span>
    </span>
    <div class="flex items-center gap-2">
      <% if pagy.previous %>
        <%= link_to url_for(index_query_params(page: pagy.previous)), class: "btn-secondary", rel: "prev" do %>
          <%= icon :chevron_left, classes: "size-3.5" %> Anterior
        <% end %>
      <% else %>
        <span class="btn-secondary opacity-40 pointer-events-none"><%= icon :chevron_left, classes: "size-3.5" %> Anterior</span>
      <% end %>
      <span class="tabular-nums px-1">Página <%= pagy.page %> de <%= pagy.pages %></span>
      <% if pagy.next %>
        <%= link_to url_for(index_query_params(page: pagy.next)), class: "btn-secondary", rel: "next" do %>
          Siguiente <%= icon :chevron_right, classes: "size-3.5" %>
        <% end %>
      <% else %>
        <span class="btn-secondary opacity-40 pointer-events-none">Siguiente <%= icon :chevron_right, classes: "size-3.5" %></span>
      <% end %>
    </div>
  </nav>
<% end %>
