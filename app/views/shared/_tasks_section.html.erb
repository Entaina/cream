<%# locals: (record:, task:) %>
<section>
  <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">
    <%= icon :check_circle, classes: "size-3.5" %> Tasks
    <span class="text-ink-faint font-normal normal-case tracking-normal">(<%= record.tasks.pending.count %> open)</span>
  </h3>

  <%= form_with model: task, url: tasks_path, class: "relative z-0 flex items-center gap-2 mb-3 overflow-visible" do |f| %>
    <%= hidden_field_tag :taskable_type, record.class.name %>
    <%= hidden_field_tag :taskable_id, record.id %>
    <%= mention_text_field f, :title, placeholder: "Add a task...", class: "input flex-1" %>
    <%= f.date_field :due_on, class: "input w-36" %>
    <%= f.submit "Add", class: "btn-secondary" %>
  <% end %>

  <ul class="space-y-1">
    <% record.tasks.due_order_desc.each do |t| %>
      <%= render "shared/task_row", task: t %>
    <% end %>
  </ul>
</section>
