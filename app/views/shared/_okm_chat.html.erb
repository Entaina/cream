<% context = okm_chat_context(@okm_chat_record) if defined?(@okm_chat_record) && @okm_chat_record %>
<div class="okm-chat-root fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3"
     data-controller="okm-chat"
     data-okm-chat-url-value="<%= okm_chat_path %>"
     data-okm-chat-actions-url-value="<%= okm_chat_actions_path %>"
     data-okm-chat-record-type-value="<%= context&.dig(:record_type) %>"
     data-okm-chat-record-id-value="<%= context&.dig(:record_id) %>"
     data-okm-chat-record-label-value="<%= context&.dig(:record_label) %>">
  <div data-okm-chat-target="panel"
       hidden
       class="okm-chat-panel card w-[min(24rem,calc(100vw-2.5rem))] h-[min(32rem,calc(100vh-8rem))] flex flex-col shadow-lg border border-line overflow-hidden">
    <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-line bg-canvas-soft">
      <div class="min-w-0">
        <p class="text-base font-medium text-ink truncate">Base de conocimiento</p>
        <p class="text-xs text-ink-faint truncate" data-okm-chat-target="contextLabel"></p>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button type="button"
                class="btn-ghost text-xs px-2 py-1"
                data-action="okm-chat#resetConversation">
          Nueva
        </button>
        <button type="button"
                class="btn-ghost p-1.5"
                aria-label="Expandir chat"
                data-okm-chat-target="expandButton"
                data-action="okm-chat#toggleExpand">
          <span data-okm-chat-target="expandIcon"><%= icon(:expand, classes: "size-4") %></span>
          <span data-okm-chat-target="shrinkIcon" hidden><%= icon(:shrink, classes: "size-4") %></span>
        </button>
        <button type="button"
                class="btn-ghost p-1.5"
                aria-label="Cerrar chat"
                data-action="okm-chat#close">
          <%= icon(:x, classes: "size-4") %>
        </button>
      </div>
    </div>

    <div data-okm-chat-target="messages"
         class="flex-1 overflow-y-auto scrollbar-subtle p-4 space-y-3 bg-canvas"></div>

    <form class="border-t border-line p-3 bg-canvas-soft space-y-2"
          data-action="submit->okm-chat#send">
      <textarea data-okm-chat-target="input"
                rows="2"
                class="input resize-none text-base"
                placeholder="Pregunta sobre clientes, ventas o estrategia…"
                data-action="keydown->okm-chat#handleKeydown"></textarea>
      <div class="flex items-center justify-between gap-2">
        <p class="text-xs text-ink-faint truncate" data-okm-chat-target="status"></p>
        <button type="submit" class="btn-primary text-sm shrink-0" data-okm-chat-target="submit">
          Enviar
        </button>
      </div>
    </form>
  </div>

  <button type="button"
          class="btn-primary rounded-full size-12 shadow-lg flex items-center justify-center"
          aria-label="Abrir chat de base de conocimiento"
          data-okm-chat-target="toggle"
          data-action="okm-chat#toggle">
    <%= icon(:message, classes: "size-5") %>
  </button>
</div>
