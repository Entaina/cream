<%# locals: f, show_how_heard: true, show_phone: true, require_phone: true %>
<div class="space-y-3">
  <%= render "public/lead_forms/contact_fields",
        f: f,
        show_phone: local_assigns.fetch(:show_phone, true),
        require_phone: local_assigns.fetch(:require_phone, true) %>
  <% if local_assigns.fetch(:show_how_heard, true) %>
    <%= render "public/lead_forms/how_heard_field", f: f %>
  <% end %>
</div>
