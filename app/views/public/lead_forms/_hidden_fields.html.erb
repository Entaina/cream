<%# locals: lead_form — tracking oculto común a todos los formularios %>
<%= hidden_field_tag "lead[#{LeadForm::TIMESTAMP_FIELD}]", LeadForm.signed_timestamp %>
<%= hidden_field_tag "lead[lead_form_slug]", lead_form.slug %>
<%= hidden_field_tag "lead[lead_form_name]", lead_form.name %>
<%= hidden_field_tag "lead[source_page]", params[:source_page], data: { lead_form_target: "sourcePage" } %>
<%= hidden_field_tag "lead[referrer]", nil, data: { lead_form_target: "referrer" } %>
<%= hidden_field_tag "lead[utm_source]", params[:utm_source], data: { lead_form_target: "utmSource" } %>
<%= hidden_field_tag "lead[utm_medium]", params[:utm_medium], data: { lead_form_target: "utmMedium" } %>
<%= hidden_field_tag "lead[utm_campaign]", params[:utm_campaign], data: { lead_form_target: "utmCampaign" } %>
<%= hidden_field_tag "lead[utm_term]", params[:utm_term], data: { lead_form_target: "utmTerm" } %>
<%= hidden_field_tag "lead[utm_content]", params[:utm_content], data: { lead_form_target: "utmContent" } %>
