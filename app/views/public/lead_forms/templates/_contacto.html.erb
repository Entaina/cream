<div class="space-y-3">
  <div>
    <%= render "public/lead_forms/field_label", f: f, field: :help_type, text: "¿En qué te ayudamos?", required: true %>
    <%= f.select :help_type,
          options_for_select(LeadForm::CONTACTO_HELP_OPTIONS),
          { include_blank: "Selecciona una opción" },
          class: "input w-full",
          required: true %>
  </div>
  <div>
    <%= f.label :message, "Cuéntanos un poco más", class: "label" %>
    <%= f.text_area :message, rows: 4, class: "input w-full resize-y", placeholder: "Opcional" %>
  </div>
  <%= render "public/lead_forms/how_heard_field", f: f %>
</div>
