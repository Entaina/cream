<%# locals: f, lead_form:, product: nil, open_editions: [] %>
<div class="space-y-3">
  <div>
    <%= render "public/lead_forms/field_label", f: f, field: :edition_id, text: "Edición", required: true %>
    <% if product.blank? %>
      <p class="text-sm text-ink-soft">No hay producto configurado para este formulario.</p>
    <% elsif open_editions.blank? %>
      <p class="text-sm text-ink-soft">No hay ediciones abiertas en este momento.</p>
    <% else %>
      <%= f.select :edition_id,
            options_from_collection_for_select(open_editions, :id, :display_name, params.dig(:lead, :edition_id)),
            { include_blank: "Elige una edición" },
            class: "input w-full",
            required: true %>
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= render "public/lead_forms/field_label", f: f, field: :first_name, text: "Nombre", required: true %>
      <%= f.text_field :first_name, required: true, class: "input w-full", autocomplete: "given-name" %>
    </div>
    <div>
      <%= render "public/lead_forms/field_label", f: f, field: :last_name, text: "Apellidos", required: true %>
      <%= f.text_field :last_name, required: true, class: "input w-full", autocomplete: "family-name" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <%= render "public/lead_forms/field_label", f: f, field: :email, text: "Email", required: true %>
      <%= f.email_field :email, required: true, class: "input w-full", autocomplete: "email" %>
    </div>
    <div>
      <%= render "public/lead_forms/field_label", f: f, field: :phone, text: "Teléfono", required: true %>
      <%= f.telephone_field :phone, required: true, class: "input w-full", autocomplete: "tel" %>
    </div>
  </div>

  <div>
    <%= f.label :message, "Mensaje", class: "label" %>
    <%= f.text_area :message, rows: 4, class: "input w-full resize-y", placeholder: "Opcional" %>
  </div>
</div>
