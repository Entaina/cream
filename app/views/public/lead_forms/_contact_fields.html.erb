<%# locals: f, show_phone: true, require_phone: true, phone_with_prefix: false %>
<div class="grid grid-cols-2 gap-3">
  <div>
    <%= render "public/lead_forms/field_label", f: f, field: :first_name, text: "Nombre", required: true %>
    <%= f.text_field :first_name, required: true, class: "input w-full", autocomplete: "given-name" %>
  </div>
  <div>
    <%= render "public/lead_forms/field_label", f: f, field: :last_name, text: "Apellidos", required: true %>
    <%= f.text_field :last_name, required: true, class: "input w-full", autocomplete: "family-name" %>
  </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
  <div>
    <%= render "public/lead_forms/field_label", f: f, field: :email, text: "Email", required: true %>
    <%= f.email_field :email, required: true, class: "input w-full", autocomplete: "email" %>
  </div>
  <% if local_assigns.fetch(:show_phone, true) %>
    <div>
      <%= render "public/lead_forms/field_label", f: f, field: :phone, text: "Teléfono", required: local_assigns.fetch(:require_phone, true) %>
      <% if local_assigns.fetch(:phone_with_prefix, false) %>
        <%= render "public/lead_forms/phone_with_prefix_field", f: f, required: local_assigns.fetch(:require_phone, true) %>
      <% else %>
        <%= f.telephone_field :phone, required: local_assigns.fetch(:require_phone, true), class: "input w-full", autocomplete: "tel" %>
      <% end %>
    </div>
  <% end %>
</div>
