<p>Hola <%= @host.name %>,</p>
<p>
  Se ha hecho una reserva de <strong><%= @event_type.localized_name %></strong>
  con <strong><%= @booking.display_name %></strong> (<%= @booking.email %>)
  en <strong><%= @booking_page.workspace.name %></strong>.
</p>
<ul>
  <li><strong><%= t("booking.mailer.host_notification.date_time") %>:</strong> <%= @starts_at_display %></li>
</ul>
<% if @deal_url %>
  <p>
    <%= link_to "Ver deal", @deal_url %>
  </p>
<% end %>
<p style="color:#999;font-size:12px;margin-top:16px;">
  Recibes este email porque tienes activadas las alertas por correo en tu perfil de Cream.
</p>
