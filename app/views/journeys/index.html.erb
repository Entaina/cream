<% page_title "Recorridos" %>
<% actions = capture do %>
  <%= link_to new_journey_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nuevo recorrido
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Recorridos", icon_name: :zap, count: @journeys.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @journeys.empty? %>
    <%= render "shared/empty_state", icon_name: :zap, title: "Sin recorridos",
          subtitle: "Automatiza secuencias de emails, esperas y tareas cuando se cumplan disparadores de marketing." %>
  <% else %>
    <% @journeys.each do |journey| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base">
            <%= link_to journey.name, journey, class: "hover:underline" %>
          </h2>
          <%= badge journey.active? ? "Activo" : "Inactivo", color: journey.active? ? "green" : "chicago" %>
          <div class="ml-auto flex gap-2">
            <%= link_to "Editar", edit_journey_path(journey), class: "btn-secondary" %>
            <%= button_to "Eliminar", journey_path(journey), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: "¿Eliminar el recorrido «#{journey.name}»?" } } %>
          </div>
        </div>
        <p class="text-sm text-ink-faint mt-1">
          Disparador: <strong><%= journey_trigger_label(journey.entry_trigger) %></strong>
          · <%= journey.steps.size %> pasos
        </p>
      </article>
    <% end %>
  <% end %>
</div>
