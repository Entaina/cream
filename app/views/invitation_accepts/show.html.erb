<% page_title "Accept invitation" %>
<div class="w-full max-w-sm">
  <div class="text-center mb-6">
    <span class="inline-flex size-10 rounded-xl bg-accent text-on-dark items-center justify-center text-lg font-bold font-display mb-3">C</span>
    <h1 class="text-xl font-semibold">Join <%= @invitation.workspace.name %></h1>
    <p class="text-base text-ink-faint mt-1">
      <%= @invitation.invited_by.name %> invited you as a <%= @invitation.role %>.
    </p>
  </div>

  <div class="card p-6 shadow-sm">
    <% if @ready_to_accept %>
      <p class="text-base text-ink-soft mb-4">
        Signed in as <strong><%= current_user.email_address %></strong>.
      </p>
      <%= button_to "Accept invitation", accept_invitation_path(params[:token]), method: :post, class: "btn-primary w-full justify-center" %>
    <% elsif @email_mismatch %>
      <div class="rounded-lg bg-orange-50 ring-1 ring-orange-200 dark:bg-orange-950 dark:ring-orange-800 px-3 py-2 text-sm text-orange-800 dark:text-orange-200 mb-4">
        You are signed in as <strong><%= current_user.email_address %></strong>, but this invitation was sent to
        <strong><%= @invitation.email_address %></strong>.
      </div>
      <%= button_to session_path, method: :delete, class: "btn-secondary w-full justify-center" do %>
        Sign out and use the invited email
      <% end %>
    <% elsif @existing_user %>
      <p class="text-base text-ink-soft mb-4">
        An account already exists for <strong><%= @invitation.email_address %></strong>. Sign in to accept.
      </p>
      <%= render "shared/google_sign_in" %>
      <div class="relative my-5">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-line"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="bg-canvas-raised px-2 text-ink-faint">or</span>
        </div>
      </div>
      <%= form_with url: session_path, class: "space-y-4" do %>
        <div>
          <label for="email_address" class="label">Email</label>
          <input type="email" name="email_address" id="email_address" required readonly
                value="<%= @invitation.email_address %>" class="input">
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <input type="password" name="password" id="password" required autocomplete="current-password"
                placeholder="••••••••" maxlength="72" class="input">
        </div>
        <input type="hidden" name="return_to" value="<%= accept_invitation_url(token: params[:token]) %>">
        <%= submit_tag "Sign in and accept", class: "btn-primary w-full justify-center" %>
      <% end %>
    <% else %>
      <p class="text-base text-ink-soft mb-4">
        Create your account to join <strong><%= @invitation.workspace.name %></strong>.
      </p>
      <%= render "shared/google_sign_in" %>
      <div class="relative my-5">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-line"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="bg-canvas-raised px-2 text-ink-faint">or</span>
        </div>
      </div>

      <% if @user&.errors&.any? %>
        <div class="mb-4 rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: accept_invitation_path(params[:token]), method: :post, class: "space-y-4" do %>
        <div>
          <label for="user_name" class="label">Name</label>
          <input type="text" name="user[name]" id="user_name" required autofocus
                value="<%= @user&.name %>" placeholder="Jane Doe" class="input">
        </div>
        <div>
          <label for="user_email" class="label">Email</label>
          <input type="email" id="user_email" readonly
                value="<%= @invitation.email_address %>" class="input">
        </div>
        <div>
          <label for="user_password" class="label">Password</label>
          <input type="password" name="user[password]" id="user_password" required
                autocomplete="new-password" placeholder="At least 8 characters" maxlength="72" class="input">
        </div>
        <div>
          <label for="user_password_confirmation" class="label">Confirm password</label>
          <input type="password" name="user[password_confirmation]" id="user_password_confirmation" required
                autocomplete="new-password" maxlength="72" class="input">
        </div>
        <%= submit_tag "Create account and accept", class: "btn-primary w-full justify-center" %>
      <% end %>
    <% end %>
  </div>
</div>
