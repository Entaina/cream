<% page_title "Reglas de scoring" %>
<% actions = capture do %>
  <%= button_to "Recalcular puntuaciones", recalculate_scoring_rules_path, method: :post, class: "btn-secondary",
        form: { data: { turbo_confirm: "¿Recalcular la puntuación de todos los contactos del workspace?" } } %>
  <%= link_to new_scoring_rule_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> Nueva regla
  <% end %>
<% end %>
<%= render "shared/page_header", title: "Reglas de scoring", icon_name: :bar_chart, count: @scoring_rules.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @scoring_rules.empty? %>
    <%= render "shared/empty_state", icon_name: :bar_chart, title: "Sin reglas de scoring",
          subtitle: "Asigna puntos automáticamente cuando los contactos abren emails, visitan páginas o envían formularios." %>
  <% else %>
    <% @scoring_rules.each do |rule| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base"><%= rule.name %></h2>
          <%= badge rule.active? ? "Activa" : "Inactiva", color: rule.active? ? "green" : "chicago" %>
          <div class="ml-auto flex gap-2">
            <%= link_to "Editar", edit_scoring_rule_path(rule), class: "btn-secondary" %>
            <%= button_to "Eliminar", scoring_rule_path(rule), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: "¿Eliminar la regla «#{rule.name}»?" } } %>
          </div>
        </div>
        <p class="text-sm text-ink-faint mt-1">
          <% if rule.event_type.present? %>
            <%= scoring_event_label(rule.event_type) %>
          <% else %>
            Cualquier evento
          <% end %>
          · <strong><%= rule.points >= 0 ? "+" : "" %><%= rule.points %></strong> pts
          <% if rule.decay_days.present? && rule.decay_days.positive? %>
            · decae en <%= rule.decay_days %> días
          <% end %>
        </p>
      </article>
    <% end %>
  <% end %>
</div>
