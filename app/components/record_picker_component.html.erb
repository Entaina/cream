<div class="relative"
     data-controller="record-picker"
     data-record-picker-search-url-value="<%= search_url %>"
     <% if create_enabled? %>
     data-record-picker-create-url-value="<%= create_url %>"
     data-record-picker-create-param-value="<%= create_param %>"
     <% end %>
     <% if inline_records %>
     data-record-picker-records-value="<%= inline_records_json %>"
     <% end %>>
  <%= form.label attribute, label, class: "label" %>
  <input type="text"
         autocomplete="off"
         class="input"
         value="<%= selected_name %>"
         placeholder="Type to search…"
         <%= "required" if required %>
         data-record-picker-target="input"
         data-action="input->record-picker#query keydown->record-picker#keydown blur->record-picker#hide focus->record-picker#focus" />
  <%= form.hidden_field attribute, data: { record_picker_target: "hidden" }.merge(hidden_data) %>
  <ul data-record-picker-target="menu"
      role="listbox"
      class="hidden absolute left-0 right-0 top-full z-50 mt-1 max-h-56 overflow-y-auto rounded-md border border-line bg-canvas shadow-sm"></ul>
  <p data-record-picker-target="error" class="hidden mt-1 text-xs text-danger"></p>
</div>
