# Copy on the server only (never commit the real .env):
#   cp .env.production.example .env
#   chmod 600 .env

# Public hostname served by your reverse proxy (e.g. Traefik)
CREAM_DOMAIN=crm.example.com

# Rails credentials (content of config/master.key from the repo)
RAILS_MASTER_KEY=

# PostgreSQL (internal Docker network; use a strong password in production)
CREAM_DATABASE_USER=cream
CREAM_DATABASE_PASSWORD=

# Google OAuth — https://console.cloud.google.com/
# Redirect URI: https://${CREAM_DOMAIN}/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database backups to Google Drive — full setup: deploy/BACKUP_SETUP.md
# Place the JSON key on the server (deploy/cream-backup.json) and mount it into the web container.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH: path inside the container to the service account JSON key
# GOOGLE_DRIVE_BACKUP_FOLDER_ID: folder ID inside a Google Workspace Shared Drive
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/cream-backup.json
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# OKM contextual chat — cache and limits (Drive ID and service account are configured per workspace in Settings)
# OKM_CACHE_TTL: document content cache in seconds (default 3600)
# OKM_INDEX_CACHE_TTL: search and folder listing cache in seconds (default 600)

# Agent memory (llmemory) — optional AES-256-GCM encryption at rest
# LLMEMORY_ENCRYPTION_KEY=

# Organization workspace for users with matching email domain
CREAM_ORGANIZATION_EMAIL_DOMAIN=example.com
CREAM_ORGANIZATION_WORKSPACE_NAME=Example

# Optional: demo users for `docker compose exec web bin/rails db:seed`
CREAM_SEED_ADMIN_EMAIL=
CREAM_SEED_ADMIN_PASSWORD=
CREAM_SEED_MEMBER_EMAIL=
CREAM_SEED_MEMBER_PASSWORD=

# Outgoing email (Mailjet SMTP)
# API Key + Secret Key: Mailjet → Account settings → SMTP and SEND API settings
# Verify your domain (SPF/DKIM) in Senders & Domains before going live.
MAILER_FROM=Cream <noreply@example.com>
SMTP_ADDRESS=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=example.com
SMTP_AUTHENTICATION=plain

# Optional
RAILS_LOG_LEVEL=info
