<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
    {% partial 'contact_fields' %}
  <div class="space-y-3">
    {% field type: "textarea", name: "ia_work_task", label: "¿Qué tarea de tu trabajo te gustaría resolver con IA y hoy no sabes?", placeholder: "Opcional" %}
    {% partial 'how_heard_field' %}
  </div>
    {% partial 'newsletter_opt_in' %}
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
