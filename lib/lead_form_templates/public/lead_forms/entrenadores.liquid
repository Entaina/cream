<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <div>
        {% field type: "text", name: "first_name", label: "Nombre", required: true, autocomplete: "given-name" %}
      </div>
      <div>
        {% field type: "text", name: "last_name", label: "Apellidos", required: true, autocomplete: "family-name" %}
      </div>
    </div>
    <div>
      {% field type: "email", name: "email", label: "Email", required: true, autocomplete: "email" %}
    </div>
  <div class="space-y-3">
    {% field type: "textarea", name: "message", label: "¿Cuál está siendo tu principal reto con la IA?", placeholder: "Opcional" %}
  </div>
    {% partial 'newsletter_opt_in' %}
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
