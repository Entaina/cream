<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
    {% partial 'contact_fields' %}
  <div class="space-y-3">
    {% field type: "select", name: "tech_profile", label: "Tu perfil técnico", options: "tech_profile", blank: "Selecciona una opción", required: true %}
    {% field type: "select", name: "audience", label: "Para ti o para tu equipo", options: "desarrollando_ia_audience", blank: "Selecciona una opción", required: true %}
    {% partial 'how_heard_field' %}
  </div>
    {% partial 'newsletter_opt_in' %}
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
