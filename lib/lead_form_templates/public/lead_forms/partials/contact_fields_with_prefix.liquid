<div class="grid grid-cols-2 gap-3">
  <div>
    {% field type: "text", name: "first_name", label: "Nombre", required: true, autocomplete: "given-name" %}
  </div>
  <div>
    {% field type: "text", name: "last_name", label: "Apellidos", required: true, autocomplete: "family-name" %}
  </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
  <div>
    {% field type: "email", name: "email", label: "Email", required: true, autocomplete: "email" %}
  </div>
  <div>
    {% field type: "label", name: "phone", label: "Teléfono", required: true %}
    {% phone_with_prefix required: true, prefixes: "+34|+34; +351|+351; +33|+33; +39|+39; +44|+44; +49|+49; +1|+1; +52|+52; +54|+54; +56|+56; +57|+57" %}
  </div>
</div>
