<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
    {% partial 'contact_fields' %}
  <div class="space-y-3">
    {% if lead_form.collects_company %}
      {% field type: "text", name: "company_name", label: "Empresa", required: true, autocomplete: "organization" %}
    {% endif %}
    {% field type: "text", name: "job_title", label: "Cargo", required: true, autocomplete: "organization-title" %}
    {% field type: "select", name: "employee_range", label: "Tamaño (nº de empleados)", options: "employee_range", blank: "Selecciona una opción", required: true %}
    {% partial 'how_heard_field' %}
  </div>
    {% partial 'newsletter_opt_in' %}
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
