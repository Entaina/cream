<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
    {% partial 'contact_fields' %}
  <div class="space-y-3">
    {% field type: "select", name: "help_type", label: "¿En qué te ayudamos?", choices: "Curso|curso; Entrenamiento|entrenamiento; Proyecto / consultoría|proyecto_consultoria; Otro|otro", blank: "Selecciona una opción", required: true %}
    {% field type: "textarea", name: "message", label: "Cuéntanos un poco más", placeholder: "Opcional" %}
    {% partial 'how_heard_field' %}
  </div>
    {% partial 'newsletter_opt_in' %}
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
