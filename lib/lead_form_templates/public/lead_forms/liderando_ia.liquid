<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
    {% partial 'contact_fields' %}
  <div class="space-y-3">
    {% field type: "text", name: "company_name", label: "Empresa", required: true, autocomplete: "organization" %}
    {% field type: "select", name: "audience", label: "¿Es para ti o para tu equipo?", options: "liderando_ia_audience", blank: "Selecciona una opción", required: true %}
    {% field type: "select", name: "how_heard", label: "¿Cómo nos has conocido?", options: "liderando_ia_how_heard", blank: "Selecciona una opción", required: true %}
  </div>
    {% partial 'newsletter_opt_in' %}
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
