<div class="mx-auto max-w-xl">
  <h1 class="font-display text-2xl font-semibold mb-4">{{ lead_form.name }}</h1>
  {% form_open %}
  {% hidden_fields %}
  {% honeypot %}

  <div class="space-y-4">
  <div class="space-y-3">
    <div>
      {% field type: "label", name: "edition_id", label: "Elige tu edición", required: true %}
      {% if product.blank %}
        <p class="text-sm text-ink-soft">No hay producto configurado para este formulario.</p>
      {% elsif open_editions.size == 0 %}
        <p class="text-sm text-ink-soft">No hay ediciones abiertas en este momento.</p>
      {% else %}
        {% field type: "radio_group", name: "edition_id", collection: "open_editions", aria_label: "Elige tu edición", required: true %}
      {% endif %}
    </div>

    {% partial 'contact_fields_with_prefix' %}
    {% field type: "textarea", name: "message", label: "¿En qué te podemos ayudar?", placeholder: "Opcional" %}
  </div>
    {% partial 'consent_fields' %}
  </div>

  {% turnstile %}
  {% submit 'Enviar' %}
  {% form_close %}
</div>
