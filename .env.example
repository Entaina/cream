# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Rails server (read by Puma via config/puma.rb)
PORT=3030

# PostgreSQL — Docker Compose service `db` (see docker-compose.yml)
CREAM_DATABASE_HOST=localhost
CREAM_DATABASE_PORT=5470
CREAM_DATABASE_USER=cream
CREAM_DATABASE_PASSWORD=cream

# Demo users created by `bin/rails db:seed`
CREAM_SEED_ADMIN_EMAIL=admin@example.com
CREAM_SEED_ADMIN_PASSWORD=creamcream
CREAM_SEED_MEMBER_EMAIL=member@example.com
CREAM_SEED_MEMBER_PASSWORD=creamcream

# Base URL for browser verification (cream-playwright skill) and Google OAuth redirect.
# Local only: http://localhost:3030
# ngrok: https://YOUR-SUBDOMAIN.ngrok-free.app (open the app with this URL for Google OAuth)
# Use the same URL in Google Cloud Console authorized redirect URIs.
CREAM_APP_URL=http://localhost:3030

# When false, only invited users and emails matching a workspace `email_domain` can register.
# Superadmins grant access via `bin/rails superadmin:grant[email]` and the /superadmin panel.
CREAM_PUBLIC_SIGNUP=true

# Legacy fallback when no workspace has `email_domain` set for that domain.
# Prefer setting email_domain on each workspace in the superadmin panel.
CREAM_ORGANIZATION_EMAIL_DOMAIN=example.com
CREAM_ORGANIZATION_WORKSPACE_NAME=Example

# Google OAuth — create credentials at https://console.cloud.google.com/
# Add every redirect URI you use (exact match, including http/https):
#   http://localhost:3030/auth/google_oauth2/callback
#   https://YOUR-SUBDOMAIN.ngrok-free.app/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database backups to Google Drive — full setup: deploy/BACKUP_SETUP.md
# GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH: path to the GCP service account JSON key file
# GOOGLE_DRIVE_BACKUP_FOLDER_ID: folder ID inside a Google Workspace Shared Drive
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# BACKUP_AGE_PUBLIC_KEY: optional age public key (age1...) to encrypt backups; keep the private key off the server
# BACKUP_AGE_PUBLIC_KEY=

# OKM contextual chat — cache and limits (Drive ID and service account are configured per workspace in Settings)
# OKM_CACHE_TTL: document content cache in seconds (default 3600)
# OKM_INDEX_CACHE_TTL: search and folder listing cache in seconds (default 600)

# Active Record encryption of connection secrets (Gmail, Calendar, Mailjet, Stripe, Beehiiv, SMTP, webhooks, OKM).
# Required in production (the app refuses to boot without them); development falls back to fixed local keys.
# Generate with `bin/rails db:encryption:init` and keep them safe: losing them makes stored tokens unreadable.
# See deploy/ENCRYPTION_ROTATION.md.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Agent memory (llmemory) — optional AES-256-GCM encryption at rest
# LLMEMORY_ENCRYPTION_KEY=

# Outgoing email (development uses Mailbin — open $CREAM_APP_URL/mailbin)
MAILER_FROM=Cream <noreply@example.com>

# Legal pages and lead form consent (optional; defaults shown)
# CREAM_OPERATOR_NAME=Example
# CREAM_PRIVACY_EMAIL=privacy@example.com
# CREAM_LEGAL_EMAIL=legal@example.com
# CREAM_SUPPORT_EMAIL=support@example.com

# Cloudflare Turnstile (invisible captcha on public lead forms).
# Optional: without these keys the forms still work without captcha
# (honeypot + time-trap + rate limiting remain active).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

CLOUDFLARE_R2_BUCKET_URL=https://<accountid>.r2.cloudflarestorage.com/<bucket>
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_DOMAIN=   # opcional

# Mailjet for marketing campaigns is configured per workspace in Settings
# (admin). SMTP_* / MAILER_FROM above remain for transactional mail.

